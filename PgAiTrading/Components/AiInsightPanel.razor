@namespace PgAiTrading.Components
@using PgAiTrading.Models

<div class="ai-insight-panel card">
    <div class="ai-insight-title">AI Analysis</div>
    <div class="ai-check-list">
        @foreach (var check in Checks)
        {
            <div class="ai-check @check.State">@check.Label</div>
        }
    </div>
    <div class="ai-probability">
        <div class="ai-probability-label">@ProbabilityLabel</div>
        <div class="ai-probability-value @GetProbabilityClass()">@Recommendation.Probability%</div>
        <div class="ai-probability-strength @GetStrengthClass()">@Recommendation.Strength</div>
    </div>
    <div class="ai-suggested">
        <div class="ai-suggested-label">Suggested</div>
        <div class="ai-suggested-action @GetActionClass()">@Recommendation.ActionHeadline</div>
        @if (!string.IsNullOrWhiteSpace(Recommendation.ActionDetail))
        {
            <div class="ai-suggested-detail">@Recommendation.ActionDetail</div>
        }
    </div>
</div>

@code {
    [Parameter] public MultiTimeframeAnalysis Analysis { get; set; } = new();
    [Parameter] public Signal Signal { get; set; } = new();

    private AiInsightRecommendation Recommendation =>
        AiInsightHelper.BuildRecommendation(Signal, Analysis);

    private IReadOnlyList<AiCheck> Checks => AiInsightHelper.BuildChecks(Analysis);

    private string ProbabilityLabel => Analysis.FrameworkReady
        ? "Entry Probability"
        : "Setup Score";

    private string GetProbabilityClass() => Recommendation.Probability switch
    {
        >= 75 => "high",
        >= 50 => "mid",
        _ => "low"
    };

    private string GetStrengthClass()
    {
        if (Analysis.FrameworkReady)
            return "strong";

        if (Recommendation.Strength.Contains("Conflict", StringComparison.OrdinalIgnoreCase))
            return "weak";

        if (Analysis.IsRotationRegime || Analysis.IsRangebound)
            return "moderate";

        return Recommendation.Probability switch
        {
            >= 75 => "strong",
            >= 50 => "moderate",
            _ => "weak"
        };
    }

    private string GetActionClass() => Recommendation.ActionKind switch
    {
        "buy" => "buy",
        "sell" => "sell",
        "wait" => "wait",
        _ => "neutral"
    };
}
