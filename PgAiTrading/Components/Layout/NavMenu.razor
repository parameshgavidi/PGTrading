@namespace PgAiTrading.Components.Layout
@using PgAiTrading.Services
@inject IWatchlistService Watchlist
@inject IUiLayoutService Layout
@inject NavigationManager Navigation
@implements IDisposable

<div class="nav-menu">
    <div class="nav-section-label">Monitor</div>
    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
        <NavIcon Name="dashboard" /> Dashboard
    </NavLink>
    <NavLink class="nav-item" href="framework">
        <NavIcon Name="framework" /> Framework
    </NavLink>
    <NavLink class="nav-item" href="multi-chart">
        <NavIcon Name="multi-chart" /> Multi Chart
    </NavLink>

    <button type="button"
            class="nav-item nav-item-button @(Layout.IsNiftyAccordionOpen ? "active" : "")"
            title="Show / hide Nifty Top 10 at top of Dashboard"
            @onclick="ToggleNiftyAccordionAsync">
        <NavIcon Name="nifty" />
        <span>Nifty Top 10</span>
    </button>

    <NavLink class="nav-item" href="scanner">
        <NavIcon Name="scanner" /> Scanner
    </NavLink>
    <NavLink class="nav-item" href="sentiment">
        <NavIcon Name="sentiment" /> Sentiment
    </NavLink>

    <div class="nav-section-label">Trade</div>
    <NavLink class="nav-item" href="signals">
        <NavIcon Name="signals" /> Signals
    </NavLink>
    <NavLink class="nav-item" href="auto-buy">
        <NavIcon Name="auto-buy" /> Auto Buy
    </NavLink>
    <NavLink class="nav-item" href="watchlist">
        <NavIcon Name="watchlist" /> Watchlist
    </NavLink>

    <div class="nav-section-label">Portfolio</div>
    <NavLink class="nav-item" href="positions">
        <NavIcon Name="positions" /> Positions
    </NavLink>
    <NavLink class="nav-item" href="orders">
        <NavIcon Name="orders" /> Orders
    </NavLink>
    <NavLink class="nav-item" href="holdings">
        <NavIcon Name="holdings" /> Holdings
    </NavLink>

    <div class="nav-section-label">System</div>
    <NavLink class="nav-item" href="strategy">
        <NavIcon Name="strategy" /> Strategy
    </NavLink>
    <NavLink class="nav-item" href="settings">
        <NavIcon Name="settings" /> Settings
    </NavLink>
</div>

@code {
    protected override void OnInitialized()
    {
        Layout.Changed += OnLayoutChanged;
        _ = Watchlist.RefreshTopWeightageAsync();
    }

    private async Task ToggleNiftyAccordionAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        if (!string.IsNullOrEmpty(path) && !path.Equals("dashboard", StringComparison.OrdinalIgnoreCase))
            Navigation.NavigateTo("/");

        await Layout.ToggleNiftyAccordionAsync();
    }

    private void OnLayoutChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Layout.Changed -= OnLayoutChanged;
    }
}
