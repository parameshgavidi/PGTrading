@page "/positions"
@inject PositionsViewModel ViewModel
@implements IDisposable

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <h2>Positions</h2>
            <button class="btn btn-secondary" disabled="@ViewModel.IsLoading" @onclick="RefreshAsync">Refresh</button>
        </div>

        @if (!ViewModel.IsConnected)
        {
            <div class="empty-state">
                <p>@ViewModel.OfflineMessage</p>
                <div class="button-row">
                    <a href="settings" class="btn btn-primary">Open Settings</a>
                </div>
            </div>
        }
        else if (ViewModel.Positions.Count == 0)
        {
            <div class="empty-state">No open positions.</div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Symbol</th>
                        <th>Qty</th>
                        <th>Avg Price</th>
                        <th>LTP</th>
                        <th>P&L</th>
                        <th>Side</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pos in ViewModel.Positions)
                    {
                        <tr>
                            <td><strong>@pos.Symbol</strong></td>
                            <td>@pos.Quantity</td>
                            <td>@pos.AveragePrice.ToString("N2")</td>
                            <td>@pos.LastPrice.ToString("N2")</td>
                            <td class="@(pos.PnL >= 0 ? "buy" : "sell")">@pos.PnL.ToString("N2")</td>
                            <td class="@GetTrendClass(pos.Side)">@pos.Side</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        await ViewModel.RefreshAsync();
    }

    private async Task RefreshAsync() => await ViewModel.RefreshAsync();

    private void OnViewModelPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private static string GetTrendClass(TrendDirection trend) => trend switch
    {
        TrendDirection.Buy => "buy",
        TrendDirection.Sell => "sell",
        _ => "neutral"
    };

    public void Dispose() => ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}
