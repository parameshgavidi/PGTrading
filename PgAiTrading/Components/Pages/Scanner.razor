@page "/scanner"
@using PgAiTrading.Services
@inject ISignalService SignalService
@inject IZerodhaService Zerodha
@inject INiftyIndexService NiftyIndex
@implements IDisposable

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <h2>Market Scanner — Nifty 50 Alignment</h2>
            <button class="btn btn-primary" disabled="@_scanning" @onclick="ScanAsync">
                @(_scanning ? "Scanning…" : "Scan Now")
            </button>
        </div>
        <p class="text-secondary">
            Scans Nifty 50 for 1H + 15m + 5m SuperTrend alignment, footprint confirmation, and framework score.
            Results appear as each stock finishes.
        </p>

        @if (!string.IsNullOrEmpty(_progressMessage))
        {
            <div class="status-message">@_progressMessage</div>
        }

        @if (_scanning)
        {
            <div class="scanning">
                Scanning… @_scannedCount/@_totalCount
                @if (!string.IsNullOrEmpty(_currentSymbol))
                {
                    <text> — @_currentSymbol</text>
                }
            </div>
            <div class="scanner-progress-track" aria-hidden="true">
                <div class="scanner-progress-fill" style="width: @ProgressPercent%"></div>
            </div>
        }

        @if (!_scanning && _results.Count == 0 && !string.IsNullOrEmpty(_errorMessage))
        {
            <div class="empty-state">@_errorMessage</div>
        }
        else if (!_scanning && _results.Count == 0)
        {
            <div class="empty-state">Click <strong>Scan Now</strong> to analyze Nifty 50 alignment.</div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Symbol</th>
                        <th>Rating</th>
                        <th>Price</th>
                        <th>1H</th>
                        <th>15m</th>
                        <th>5m</th>
                        <th>RSI</th>
                        <th>ADX</th>
                        <th>TPO</th>
                        <th>Footprint</th>
                        <th>Framework</th>
                        <th>Score</th>
                        <th>Signal</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in _results)
                    {
                        <tr class="@(result.Aligned ? "aligned-row" : "")">
                            <td><strong>@result.Symbol</strong></td>
                            <td><span class="scanner-stars">@RenderStars(result)</span></td>
                            <td>@(result.Price > 0 ? result.Price.ToString("N2") : "—")</td>
                            <td class="@GetTrendClass(result.Trend1H)">@GetBadgeLabel(result.Trend1H)</td>
                            <td class="@GetTrendClass(result.Trend15M)">@GetBadgeLabel(result.Trend15M)</td>
                            <td class="@GetTrendClass(result.Trend5M)">@GetBadgeLabel(result.Trend5M)</td>
                            <td>@result.Rsi.ToString("0")</td>
                            <td>@result.Adx.ToString("0")</td>
                            <td class="@(result.TpoConfirmed ? "buy" : "sell")">@(result.TpoConfirmed ? "OK" : "—")</td>
                            <td class="@(result.FootprintConfirmed ? "buy" : "sell")">@(result.FootprintConfirmed ? "OK" : "—")</td>
                            <td>@result.FrameworkStatus</td>
                            <td><span class="score-badge">@result.Score%</span></td>
                            <td class="@GetTrendClass(result.Signal)">@(result.Aligned ? GetBadgeLabel(result.Signal) : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    private const int MaxParallel = 4;

    private bool _scanning;
    private int _scannedCount;
    private int _totalCount;
    private string _currentSymbol = string.Empty;
    private string _progressMessage = string.Empty;
    private string _errorMessage = string.Empty;
    private List<ScanResult> _results = new();
    private CancellationTokenSource? _cts;

    private int ProgressPercent =>
        _totalCount <= 0 ? 0 : Math.Clamp((int)Math.Round(100.0 * _scannedCount / _totalCount), 0, 100);

    protected override async Task OnInitializedAsync() => await ScanAsync();

    private async Task ScanAsync()
    {
        if (_scanning)
            return;

        _cts?.Cancel();
        _cts?.Dispose();
        _cts = new CancellationTokenSource();
        var ct = _cts.Token;

        _scanning = true;
        _scannedCount = 0;
        _totalCount = 0;
        _currentSymbol = string.Empty;
        _errorMessage = string.Empty;
        _results = new List<ScanResult>();
        _progressMessage = "Loading Nifty 50 symbols…";
        await InvokeAsync(StateHasChanged);

        try
        {
            var universe = (await NiftyIndex.GetNifty50SymbolsAsync()).ToList();
            if (universe.Count == 0)
                universe = NiftyConstituents.TopWeightage.ToList();

            universe = universe
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Select(s => s.Trim().ToUpperInvariant())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .ToList();

            if (universe.Count == 0)
            {
                _errorMessage = "Could not load Nifty 50 symbol list.";
                _progressMessage = _errorMessage;
                return;
            }

            _totalCount = universe.Count;
            _progressMessage = $"Fetching quotes for {universe.Count} stocks…";
            await InvokeAsync(StateHasChanged);

            var quotes = await FetchQuotesAsync(universe);
            ct.ThrowIfCancellationRequested();

            using var gate = new SemaphoreSlim(MaxParallel);
            var lockObj = new object();
            var working = new List<ScanResult>();

            var tasks = universe.Select(async symbol =>
            {
                await gate.WaitAsync(ct);
                try
                {
                    ct.ThrowIfCancellationRequested();

                    lock (lockObj)
                        _currentSymbol = symbol;
                    await InvokeAsync(StateHasChanged);

                    var price = quotes.GetValueOrDefault($"NSE:{symbol}", 0m);
                    ScanResult row;
                    try
                    {
                        var analysis = await SignalService.AnalyzeAsync(symbol);
                        row = new ScanResult
                        {
                            Symbol = symbol,
                            Price = price > 0 ? price : analysis.ReferencePrice,
                            Trend1H = analysis.Trend1H,
                            Trend15M = analysis.Trend15M,
                            Trend5M = analysis.Trend5M,
                            Rsi = analysis.Rsi,
                            Adx = analysis.Adx,
                            Score = analysis.OverallScore,
                            Signal = analysis.FrameworkReady ? analysis.TradeDirection : TrendDirection.Neutral,
                            Aligned = analysis.FrameworkReady,
                            FrameworkReady = analysis.FrameworkReady,
                            FootprintConfirmed = analysis.FootprintConfirmed,
                            TpoConfirmed = analysis.TpoConfirmed,
                            FrameworkStatus = analysis.FrameworkStatus
                        };
                    }
                    catch (Exception ex)
                    {
                        row = new ScanResult
                        {
                            Symbol = symbol,
                            Price = price,
                            FrameworkStatus = $"Error: {ex.Message}",
                            Score = 0
                        };
                    }

                    int done;
                    lock (lockObj)
                    {
                        working.Add(row);
                        done = working.Count;
                        _scannedCount = done;
                        _results = working
                            .OrderByDescending(r => r.Score)
                            .ThenBy(r => r.Symbol)
                            .ToList();
                        _progressMessage = $"Scanned {done}/{universe.Count} — last {symbol}";
                    }

                    await InvokeAsync(StateHasChanged);
                }
                finally
                {
                    gate.Release();
                }
            });

            await Task.WhenAll(tasks);
            ct.ThrowIfCancellationRequested();

            _progressMessage = _results.Count > 0
                ? $"Scan complete — {_results.Count} stocks ranked by framework score."
                : "Scan complete — no rows returned.";
        }
        catch (OperationCanceledException)
        {
            _progressMessage = "Scan cancelled.";
        }
        catch (Exception ex)
        {
            _errorMessage = $"Scan failed: {ex.Message}";
            _progressMessage = _errorMessage;
        }
        finally
        {
            _scanning = false;
            _currentSymbol = string.Empty;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<Dictionary<string, decimal>> FetchQuotesAsync(IReadOnlyList<string> symbols)
    {
        var quotes = new Dictionary<string, decimal>(StringComparer.OrdinalIgnoreCase);
        if (!Zerodha.IsConnected)
            return quotes;

        try
        {
            const int batchSize = 400;
            for (var i = 0; i < symbols.Count; i += batchSize)
            {
                var batch = symbols.Skip(i).Take(batchSize).Select(s => $"NSE:{s}").ToArray();
                var batchQuotes = await Zerodha.GetQuotesAsync(batch);
                foreach (var (key, value) in batchQuotes)
                    quotes[key] = value;
            }
        }
        catch
        {
            // Prices optional — analysis still runs.
        }

        return quotes;
    }

    private static string GetTrendClass(TrendDirection trend) => TrendUi.GetClass(trend);

    private static string GetBadgeLabel(TrendDirection trend) => TrendUi.GetBadgeLabel(trend);

    private static MarkupString RenderStars(ScanResult result)
    {
        var stars = 1;
        if (result.Score >= 40) stars = 2;
        if (result.Score >= 55) stars = 3;
        if (result.Score >= 70) stars = 4;
        if (result.Aligned && result.Score >= 75) stars = 5;
        if (result.FrameworkReady)
            stars = Math.Max(stars, 4);

        var filled = new string('★', stars);
        var empty = new string('★', 5 - stars);
        return new MarkupString($"{filled}<span class=\"dim\">{empty}</span>");
    }

    public void Dispose()
    {
        _cts?.Cancel();
        _cts?.Dispose();
    }

    private class ScanResult
    {
        public string Symbol { get; set; } = "";
        public decimal Price { get; set; }
        public TrendDirection Trend1H { get; set; }
        public TrendDirection Trend15M { get; set; }
        public TrendDirection Trend5M { get; set; }
        public decimal Rsi { get; set; }
        public decimal Adx { get; set; }
        public int Score { get; set; }
        public TrendDirection Signal { get; set; }
        public bool Aligned { get; set; }
        public bool FrameworkReady { get; set; }
        public bool FootprintConfirmed { get; set; }
        public bool TpoConfirmed { get; set; }
        public string FrameworkStatus { get; set; } = "";
    }
}
