@page "/framework"

<div class="page-container framework-page">
    <div class="card framework-card">
        <div class="card-header">
            <h2>Daily Intraday Framework</h2>
            <span class="framework-date">@DateTime.Now.ToString("dd MMM yyyy")</span>
        </div>

        <p class="text-secondary framework-intro">
            Read every morning before the session. Rules below are enforced for Dashboard, Live Signals,
            Scanner, and Intraday Scan. 1H market structure, Camarilla, CPR, and TPO remain chart show/hide
            overlays only (use the Structure button on charts).
        </p>

        <div class="framework-band-grid framework-band-grid-2">
            <div class="card framework-subcard">
                <h3>ADX (14) — 1 Hour</h3>
                <table class="framework-table framework-band-table">
                    <thead>
                        <tr><th>Band</th><th>Value</th><th>Meaning</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var band in FrameworkPlaybook.AdxBands)
                        {
                            <tr class="@band.Css">
                                <td><strong>@band.Band</strong></td>
                                <td>@band.Range</td>
                                <td>@band.Meaning</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card framework-subcard">
                <h3>RSI (28) — 1 Hour</h3>
                <table class="framework-table framework-band-table">
                    <thead>
                        <tr><th>Bias</th><th>Value</th><th>Meaning</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var band in FrameworkPlaybook.RsiBands)
                        {
                            <tr class="@band.Css">
                                <td><strong>@band.Band</strong></td>
                                <td>@band.Range</td>
                                <td>@band.Meaning</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card framework-subcard framework-flow">
            <h3>Decision order (top to bottom)</h3>
            <ol class="framework-steps">
                <li><span class="tag wait">G0</span> 5m RSI(28) &lt; 30 → <strong>EXPECT REVERSAL</strong></li>
                <li><span class="tag wait">G0b</span> 5m RSI(28) &lt; 30 + any bullish 5m pattern → <strong>WAIT</strong> (no new entry)</li>
                <li><span class="tag step">1</span> <strong>Bias</strong> — 1H SuperTrend + VWAP (direction)</li>
                <li><span class="tag step">2</span> <strong>Regime</strong> — RSI(28) + ADX (trend / strong chop / developing)</li>
                <li><span class="tag step">3</span> <strong>Volume Profile</strong> — POC / VAH / VAL / PDH / PDL location</li>
                <li><span class="tag step">4</span> <strong>Liquidity sweep</strong> — sweep → reclaim (esp. strong chop)</li>
                <li><span class="tag step">5</span> <strong>Footprint</strong> — absorption / delta confirmation</li>
                <li><span class="tag step">6</span> <strong>5M BOS</strong> entry (+ ST 7,2.5 trailing stop)</li>
                <li><span class="tag range">note</span> 1H structure / Camarilla / CPR / TPO = <strong>chart toggles only</strong> (not gates)</li>
                <li><span class="tag wait">AI</span> Dashboard AI — WAIT until FrameworkReady</li>
            </ol>
        </div>

        <div class="card framework-subcard">
            <h3>Indicator parameters</h3>
            <table class="framework-table">
                <thead>
                    <tr><th>Indicator</th><th>Timeframe</th><th>Settings</th><th>Purpose</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in IndicatorRows)
                    {
                        <tr>
                            <td>@row.Name</td>
                            <td>@row.Timeframe</td>
                            <td>@row.Settings</td>
                            <td>@row.Purpose</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @foreach (var group in FrameworkPlaybook.Groups)
        {
            <div class="card framework-subcard framework-rule-group" id="fw-@group.Key">
                <h3>@group.Title</h3>
                @if (!string.IsNullOrEmpty(group.Intro))
                {
                    <p class="framework-group-intro">@group.Intro</p>
                }
                @if (!string.IsNullOrEmpty(group.Subtitle))
                {
                    <h4 class="framework-subheading">@group.Subtitle</h4>
                }
                <div class="framework-rules">
                    @if (group.Rules is not null)
                    {
                    @foreach (var rule in group.Rules)
                    {
                        <div class="framework-rule">
                            <div class="framework-rule-id">@rule.Id</div>
                            <div class="framework-rule-body">
                                <div class="framework-rule-title">@rule.Title</div>
                                <div class="framework-rule-row">
                                    <span class="framework-label">IF</span>
                                    <span class="framework-condition">@rule.Condition</span>
                                </div>
                                @if (!string.IsNullOrEmpty(rule.Action))
                                {
                                    <div class="framework-rule-row">
                                        <span class="framework-label action">THEN</span>
                                        <span class="framework-action">@rule.Action</span>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(rule.Note))
                                {
                                    <div class="framework-note">@rule.Note</div>
                                }
                            </div>
                        </div>
                    }
                    }
                </div>
            </div>
        }

        <div class="card framework-subcard">
            <h3>Priority ranking</h3>
            <ol class="framework-priority">
                @foreach (var item in PriorityItems)
                {
                    <li>@item</li>
                }
            </ol>
        </div>
    </div>
</div>

@code {
    private static readonly IReadOnlyList<(string Name, string Timeframe, string Settings, string Purpose)> IndicatorRows =
    [
        ("RSI", "1 Hour", "Length 28", "Regime with ADX (>55 / 45–55 / <45)"),
        ("RSI", "5 Minutes", "Length 28", "G0 EXPECT REVERSAL (<30); G0b WAIT with bullish pattern"),
        ("ADX", "1 Hour", "Length 14", "<18 chop · >22 developing · >25 strong"),
        ("Session Volume Profile", "Session", "POC / VAH / VAL / PDH / PDL", "Location + liquidity levels"),
        ("Liquidity sweep", "5 Minutes", "Sweep → reclaim", "Setup at profile/session levels"),
        ("Footprint", "5 Minutes", "Delta + absorption", "Confirm reaction at level"),
        ("SuperTrend", "1H / 15M / 5M", "(10,3) / (10,3) / (7,2.5)", "Bias + alignment + trailing stop"),
        ("VWAP", "5m session", "Session-anchored", "Soft alignment with 1H ST"),
        ("15M / 5M structure", "15M / 5M", "BOS / CHOCH", "Setup + entry triggers"),
        ("1H market structure", "Chart only", "Structure toggle", "Display — not a framework gate"),
        ("Camarilla / CPR / TPO", "Chart only", "Show/hide toggles", "Display — not framework gates")
    ];

    private static readonly IReadOnlyList<string> PriorityItems =
    [
        "1H SuperTrend + VWAP bias",
        "RSI(28) + ADX regime on 1H",
        "15M structure BOS with bias",
        "Session Volume Profile (POC / VAH / VAL / PDH / PDL)",
        "Liquidity sweep → reclaim",
        "Footprint absorption / delta confirmation",
        "5M BOS entry (ST 7,2.5 trailing stop)",
        "Chart-only: 1H Structure label, Camarilla, CPR, TPO display toggles"
    ];
}
