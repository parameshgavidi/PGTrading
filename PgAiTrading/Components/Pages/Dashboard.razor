  {
    await ViewModel.SelectInstrumentAsync(symbol);
  }

  private static string GetTrendClass(TrendDirection trend) => TrendUi.GetClass(trend);

  private static string GetAdxStrengthLabel(MultiTimeframeAnalysis analysis) => analysis.Strength1H switch
  {
      TrendStrength.Strong => "Strong (>25)",
      TrendStrength.Moderate => "Moderate (18–25)",
      _ => "Choppy (<18)"
  };

  private static string GetOverallScoreClass(MultiTimeframeAnalysis analysis) => analysis.Strength1H switch
  {
      TrendStrength.Strong => "buy",
      TrendStrength.Moderate => "neutral",
      _ => "sell"
  };

  private static string GetTrailingRowClass(TrailingStopRow item) => item.ExitPlaced
      ? "closed-row"
      : item.IsTriggered ? "review-row" : "aligned-row";

  private static string GetTrailingStatusClass(TrailingStopRow item) => item.ExitPlaced
      ? "neutral"
      : item.IsTriggered ? "sell" : "buy";

  public void Dispose()
  {
    _refreshCts?.Cancel();
    _refreshCts?.Dispose();
    _entryAlertBannerCts?.Cancel();
    _entryAlertBannerCts?.Dispose();
    ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    SentimentViewModel.PropertyChanged -= OnSentimentPropertyChanged;
    EntryAlertService.EntryDetected -= OnEntryDetected;
    Layout.Changed -= OnLayoutChanged;
  }
}
