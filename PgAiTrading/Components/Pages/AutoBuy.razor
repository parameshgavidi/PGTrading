@page "/auto-buy"
@inject AutoBuyViewModel ViewModel
@inject DashboardViewModel Dashboard
@inject NavigationManager Navigation
@implements IDisposable

<div class="page-container auto-buy-page">
    <div class="card">
        <div class="card-header">
            <h2>Auto Buy <span class="summary-pill buy">Long only</span></h2>
            <div class="card-header-actions">
                <label class="checkbox-label master-automation-toggle">
                    <input type="checkbox"
                           checked="@ViewModel.MasterAutomationEnabled"
                           @onchange="OnMasterAutomationChanged" />
                    Master automation
                </label>
                @if (ViewModel.IsMonitoring)
                {
                    <span class="summary-pill buy">Monitoring</span>
                }
            </div>
        </div>

        <p class="text-secondary">
            <strong>BUY only</strong> when <strong>ST(7,2.5) triggers Buy</strong> on the last completed candle.
            Otherwise <strong>wait</strong> for the buy signal. Long CNC hold — never sells.
            <strong>Multiple NSE equities</strong> — each row has its own timeframe (1m/5m/15m), quantity, and max deploy cap.
            Starts automatically when the app opens if <strong>Master automation</strong> is on (no need to stay on this tab).
            Delivery CNC only (no MIS / F&amp;O).
            Saved to <code>@ViewModel.StoragePath</code>.
        </p>

        @if (!ViewModel.IsConnected)
        {
            <div class="holdings-banner warning">
                <span>Connect Zerodha to search symbols and place Auto Buy CNC orders.</span>
                <a href="settings">Open Settings</a>
            </div>
        }

        @if (!ViewModel.IsAutoTradingEnabled)
        {
            <div class="holdings-banner warning">
                Live orders blocked — open <strong>Settings</strong> → <strong>Trading</strong> → check <strong>Auto Trading</strong> → click <strong>Save Settings</strong>.
            </div>
        }

        <div class="framework-panel auto-buy-readiness">
            <div class="framework-panel-title">System readiness (shared gates)</div>
            <p class="text-secondary auto-buy-readiness-hint">
                When these pass, automation can place orders. <strong>Each stock enters on its own</strong> ST(7,2.5) buy signal — see Status in the table below.
            </p>
            <ul class="framework-conditions compact">
                @foreach (var check in ViewModel.GetReadinessChecks())
                {
                    <li class="@(check.Passed ? "ready" : "blocked")">
                        <span class="readiness-mark">@(check.Passed ? "✓" : "✗")</span>
                        <strong>@check.Label</strong> — @check.Detail
                    </li>
                }
            </ul>
        </div>

        <div class="auto-buy-toolbar">
            <div class="symbol-search-wrap">
                <label for="auto-buy-search">Search NSE company</label>
                <input id="auto-buy-search"
                       class="form-input symbol-search-input"
                       placeholder="Type symbol e.g. RELIANCE"
                       value="@_searchText"
                       @oninput="OnSearchChanged"
                       @onfocus="() => _showSuggestions = _suggestions.Count > 0" />
                @if (_showSuggestions && _suggestions.Count > 0)
                {
                    <div class="symbol-suggestions">
                        @foreach (var symbol in _suggestions)
                        {
                            <button type="button"
                                    class="symbol-suggestion-item"
                                    @onclick="() => SelectSuggestionAsync(symbol)">
                                @symbol
                            </button>
                        }
                    </div>
                }
            </div>
            <button type="button" class="btn btn-primary" @onclick="AddFromSearchAsync"
                    disabled="@(string.IsNullOrWhiteSpace(_searchText) || ViewModel.Rows.Count >= AutoBuyDefaults.MaxSymbols)">
                Add company
            </button>
            <button type="button" class="btn btn-secondary" @onclick="RefreshSymbolsAsync" disabled="@ViewModel.IsLoadingSymbols">
                @(ViewModel.IsLoadingSymbols ? "Loading symbols…" : "Refresh NSE list")
            </button>
        </div>

        @if (ViewModel.IsLoadingSymbols)
        {
            <div class="chart-meta">Loading NSE symbols…</div>
        }

        @if (!string.IsNullOrEmpty(ViewModel.StatusMessage))
        {
            <div class="status-message">@ViewModel.StatusMessage</div>
        }

        @if (ViewModel.Rows.Count >= AutoBuyDefaults.MaxSymbols)
        {
            <div class="chart-meta">List limit reached ({AutoBuyDefaults.MaxSymbols} symbols) — remove a row to add another.</div>
        }

        @if (ViewModel.Rows.Count == 0)
        {
            <div class="empty-state">No companies in Auto Buy list. Search and add NSE symbols above.</div>
        }
        else
        {
            <table class="data-table auto-buy-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Symbol</th>
                        <th>Timeframe</th>
                        <th>Qty</th>
                        <th>Deployed</th>
                        <th>Max deploy</th>
                        <th>Automation</th>
                        <th>Status</th>
                        <th>Detail</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @{ var rowIndex = 0; }
                    @foreach (var row in ViewModel.Rows)
                    {
                        rowIndex++;
                        <tr class="auto-buy-row @(row.AutomationEnabled ? "" : "dim-row")"
                            @onclick="async () => await OpenRowModal(row)">
                            <td class="auto-buy-serial">@rowIndex</td>
                            <td><strong>@row.Symbol</strong></td>
                            <td>@row.Timeframe</td>
                            <td>@row.Lots</td>
                            <td>₹@row.DeployedAmount.ToString("N0")</td>
                            <td>@(row.MaxDeployAmount > 0 ? $"₹{row.MaxDeployAmount:N0}" : "—")</td>
                            <td @onclick:stopPropagation="true">
                                <label class="checkbox-label inline-toggle">
                                    <input type="checkbox"
                                           checked="@row.AutomationEnabled"
                                           @onchange="e => OnRowAutomationChanged(row.Symbol, e)" />
                                    @(row.AutomationEnabled ? "On" : "Off")
                                </label>
                            </td>
                            <td class="@GetStatusClass(row.Status)">@row.Status</td>
                            <td class="auto-buy-detail">@row.Detail</td>
                            <td @onclick:stopPropagation="true" class="auto-buy-actions">
                                <button type="button"
                                        class="btn btn-sm @(IsChartSymbol(row.Symbol) ? "btn-primary auto-buy-view-chart active" : "btn-secondary auto-buy-view-chart")"
                                        title="Open @row.Symbol on Dashboard"
                                        @onclick="() => ViewChartAsync(row.Symbol)">
                                    View chart
                                </button>
                                <button type="button"
                                        class="btn btn-secondary btn-sm"
                                        @onclick="() => RemoveRowAsync(row.Symbol)">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@if (_showRowModal && _editRow is not null)
{
    <div class="modal-overlay" @onclick="CloseRowModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Auto Buy — @(_editRow.Symbol)</h3>
                <button type="button" class="modal-close" @onclick="CloseRowModal">×</button>
            </div>
            <div class="modal-body">
                <p class="text-secondary modal-intro">
                    <strong>Long entry only</strong> — places <strong>BUY CNC</strong> when <strong>ST(7, 2.5)</strong>
                    turns <span class="buy">Buy</span> on the last completed candle (buy trigger).
                    Otherwise waits for the signal. Never sells or shorts.
                </p>

                <div class="form-row">
                    <label for="ab-timeframe">Timeframe</label>
                    <select id="ab-timeframe" class="form-input" @bind="_editRow.Timeframe">
                        @foreach (var tf in AutoBuyTimeframes.All)
                        {
                            <option value="@tf">@tf</option>
                        }
                    </select>
                </div>

                <div class="form-row">
                    <label for="ab-lots">Quantity (shares)</label>
                    <input id="ab-lots"
                           type="number"
                           min="1"
                           class="form-input"
                           @bind="_editRow.Lots"
                           @bind:event="oninput" />
                </div>

                <div class="form-row">
                    <label for="ab-max">Max amount to deploy (₹)</label>
                    <input id="ab-max"
                           type="number"
                           min="0"
                           step="100"
                           class="form-input"
                           placeholder="0 = no limit"
                           @bind="_editRow.MaxDeployAmount"
                           @bind:event="oninput" />
                    <span class="text-secondary form-hint">
                        Deployed now: ₹@_editRow.DeployedAmount.ToString("N0").
                        When deployed ≥ max, automation turns off and saves to storage.
                    </span>
                </div>

                <div class="form-row">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="_editRow.AutomationEnabled" />
                        Enable automation for this row
                    </label>
                </div>

                <ul class="framework-conditions compact">
                    <li>Per row: timeframe (1m/5m/15m), quantity, and max deploy apply only to that stock</li>
                    <li>BUY when ST(7,2.5) triggers Buy on last closed bar — otherwise wait</li>
                    <li>No SELL orders — automation never exits or shorts</li>
                    <li>Uses last closed bar (not the live forming candle)</li>
                    <li>NSE equity CNC delivery only — no F&amp;O</li>
                    <li>Max deploy cap disables automation when reached</li>
                    <li>Requires master automation + Settings → Auto Trading enabled</li>
                </ul>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" @onclick="CloseRowModal">Cancel</button>
                <button type="button" class="btn btn-primary" @onclick="SaveRowModalAsync">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private string _searchText = string.Empty;
    private bool _showSuggestions;
    private List<string> _suggestions = new();
    private bool _showRowModal;
    private AutoBuyRow? _editRow;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        Dashboard.PropertyChanged += OnDashboardPropertyChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await ViewModel.InitializeAsync();
        await ViewModel.RefreshSettingsAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (!e.Location.Contains("auto-buy", StringComparison.OrdinalIgnoreCase))
            return;

        _ = InvokeAsync(async () =>
        {
            await ViewModel.RefreshSettingsAsync();
            StateHasChanged();
        });
    }

    private async Task OnSearchChanged(ChangeEventArgs e)
    {
        _searchText = e.Value?.ToString() ?? string.Empty;

        // If the universe is not ready yet, kick a load so suggestions can appear.
        if (!ViewModel.IsLoadingSymbols
            && ViewModel.NseSymbols.Count == 0)
        {
            await ViewModel.RefreshSymbolsAsync();
        }

        _suggestions = ViewModel.SearchSymbols(_searchText).ToList();
        _showSuggestions = _suggestions.Count > 0;
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnDashboardPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName is null
            || e.PropertyName == nameof(DashboardViewModel.SelectedSymbol)
            || e.PropertyName == nameof(DashboardViewModel.SelectedInstrument))
        {
            InvokeAsync(StateHasChanged);
        }
    }

    private bool IsChartSymbol(string symbol) =>
        string.Equals(Dashboard.SelectedSymbol, symbol, StringComparison.OrdinalIgnoreCase);

    private async Task SelectSuggestionAsync(string symbol)
    {
        _searchText = symbol;
        _showSuggestions = false;
        await AddFromSearchAsync();
    }

    private async Task AddFromSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return;

        await ViewModel.AddSymbolAsync(_searchText.Trim());
        _searchText = string.Empty;
        _showSuggestions = false;
        _suggestions.Clear();
    }

    private async Task RefreshSymbolsAsync() => await ViewModel.RefreshSymbolsAsync();

    private async Task RemoveRowAsync(string symbol) => await ViewModel.RemoveSymbolAsync(symbol);

    private async Task ViewChartAsync(string symbol)
    {
        if (string.IsNullOrWhiteSpace(symbol))
            return;

        var normalized = symbol.Trim().ToUpperInvariant();
        await Dashboard.SelectInstrumentAsync(normalized);

        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        if (!string.IsNullOrEmpty(path)
            && !path.Equals("dashboard", StringComparison.OrdinalIgnoreCase))
        {
            Navigation.NavigateTo("/");
        }
    }

    private async Task OnMasterAutomationChanged(ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        await ViewModel.SetMasterAutomationAsync(enabled);
    }

    private async Task OnRowAutomationChanged(string symbol, ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        await ViewModel.SetRowAutomationAsync(symbol, enabled);
    }

    private async Task OpenRowModal(AutoBuyRow row)
    {
        await ViewModel.RefreshDeployedAmountsAsync();

        var current = ViewModel.Rows.FirstOrDefault(r =>
            r.Symbol.Equals(row.Symbol, StringComparison.OrdinalIgnoreCase)) ?? row;

        _editRow = new AutoBuyRow
        {
            Symbol = current.Symbol,
            Exchange = current.Exchange,
            Timeframe = current.Timeframe,
            Lots = current.Lots,
            MaxDeployAmount = current.MaxDeployAmount,
            AutomationEnabled = current.AutomationEnabled,
            DeployedAmount = current.DeployedAmount
        };
        _showRowModal = true;
    }

    private void CloseRowModal()
    {
        _showRowModal = false;
        _editRow = null;
    }

    private async Task SaveRowModalAsync()
    {
        if (_editRow is null)
            return;

        _editRow.Lots = Math.Max(1, _editRow.Lots);
        _editRow.MaxDeployAmount = Math.Max(0, _editRow.MaxDeployAmount);
        _editRow.Timeframe = AutoBuyTimeframes.Normalize(_editRow.Timeframe);
        await ViewModel.UpdateRowAsync(_editRow);
        CloseRowModal();
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Order placed" => "buy",
        "Flip detected" => "sell",
        "Order failed" or "Error" or "Max reached" => "sell",
        "Watching" => "",
        _ => ""
    };

    public void Dispose()
    {
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
