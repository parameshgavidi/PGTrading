@page "/multi-chart"
@inject MultiChartViewModel ViewModel
@inject IUiLayoutService Layout
@implements IDisposable

<div class="multi-chart-page">
    <div class="multi-chart-main card">
        <div class="chart-header multi-chart-header">
            <div class="instrument-info">
                <div class="instrument-title-row">
                    <h2>@ViewModel.SelectedDisplayName</h2>
                    <span class="market-status @(ViewModel.IsMarketOpen ? "open" : "closed")">
                        @ViewModel.MarketStatus
                    </span>
                </div>
                <div class="price-row">
                    <span class="price">@ViewModel.LivePrice.ToString("N2")</span>
                    <span class="change @(ViewModel.LiveChange >= 0 ? "positive" : "negative")">
                        @(ViewModel.LiveChange >= 0 ? "▲" : "▼") @Math.Abs(ViewModel.LiveChange).ToString("N2") (@ViewModel.LiveChangePercent%)
                    </span>
                </div>
            </div>
            <div class="multi-chart-layout-switch" role="group" aria-label="Chart layout">
                <button type="button"
                        class="layout-toggle @(!Layout.IsMultiChartStacked ? "active" : "")"
                        title="Side by side"
                        aria-pressed="@(!Layout.IsMultiChartStacked)"
                        @onclick="() => SetLayoutAsync(stacked: false)">
                    <span class="multi-chart-layout-icon side-by-side" aria-hidden="true"></span>
                    <span class="layout-toggle-label">Side by side</span>
                </button>
                <button type="button"
                        class="layout-toggle @(Layout.IsMultiChartStacked ? "active" : "")"
                        title="Stacked vertically"
                        aria-pressed="@Layout.IsMultiChartStacked"
                        @onclick="() => SetLayoutAsync(stacked: true)">
                    <span class="multi-chart-layout-icon stacked" aria-hidden="true"></span>
                    <span class="layout-toggle-label">Stacked</span>
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewModel.StartupError))
        {
            <div class="chart-meta warning">Startup: @ViewModel.StartupError</div>
        }
        @if (!ViewModel.IsReady)
        {
            <div class="chart-meta">Loading charts…</div>
        }

        <div class="multi-chart-grid @(Layout.IsMultiChartStacked ? "stacked" : "side-by-side")">
            <ChartPanelCard Panel="ViewModel.Panel5m"
                            Analysis="ViewModel.Analysis"
                            ViewModel="ViewModel" />
            <ChartPanelCard Panel="ViewModel.Panel15m"
                            Analysis="ViewModel.Analysis"
                            ViewModel="ViewModel" />
        </div>
    </div>
</div>

@code {
    private CancellationTokenSource? _refreshCts;

    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        Layout.Changed += OnLayoutChanged;
        _refreshCts = new CancellationTokenSource();
        _ = LoadAsync();
        _ = RunRefreshLoopAsync(_refreshCts.Token);
    }

    private async Task LoadAsync()
    {
        await ViewModel.InitializeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetLayoutAsync(bool stacked) =>
        await Layout.SetMultiChartStackedAsync(stacked);

    private async Task RunRefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await ViewModel.RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Page closed.
        }
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnLayoutChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        _refreshCts?.Cancel();
        _refreshCts?.Dispose();
        ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
        Layout.Changed -= OnLayoutChanged;
    }
}
