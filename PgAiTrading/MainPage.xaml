<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:PgAiTrading.Components"
             x:Class="PgAiTrading.MainPage"
             BackgroundColor="#121212">

    <Grid RowDefinitions="Auto,*">
        <Label x:Name="statusBanner"
               Grid.Row="0"
               Text="Starting PG AI Trading..."
               TextColor="White"
               BackgroundColor="#2196F3"
               Padding="10"
               HorizontalTextAlignment="Center" />

        <BlazorWebView x:Name="blazorWebView"
                       Grid.Row="1"
                       HostPage="wwwroot/index.html"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"
                       BlazorWebViewInitialized="OnBlazorWebViewInitialized">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <Border x:Name="errorPanel"
                Grid.Row="1"
                IsVisible="False"
                BackgroundColor="#1E1E1E"
                Stroke="#FF1744"
                StrokeThickness="1"
                Padding="24"
                Margin="24"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="520">
                <Label Text="PG AI Trading could not load the UI"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label x:Name="errorMessage"
                       TextColor="#B0B0B0"
                       LineBreakMode="WordWrap" />
                <Label Text="Try force-closing the app and opening it again. On Windows, enable Developer Mode if packaging requires it."
                       TextColor="#B0B0B0"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
