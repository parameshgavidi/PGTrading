@namespace PGOne.Components
@using PGOne.ViewModels

<CandlestickChart @key="@ChartSurfaceKey"
                  CanvasId="@CanvasId"
                  Candles="ViewModel.ChartCandles"
                  ChartVersion="ViewModel.ChartVersion"
                  OverlayVersion="ViewModel.OverlayVersion"
                  Analysis="ViewModel.Analysis"
                  CprSegments="ViewModel.CprSegments"
                  ShowPocLevels="ViewModel.ShowPocOverlay"
                  ShowPivotLevels="ViewModel.ShowPivotOverlay"
                  ShowCamarillaLevels="ViewModel.ShowCamarillaOverlay"
                  ShowKeltnerLevels="ViewModel.ShowKeltnerOverlay"
                  ShowIntradayCprLevels="ViewModel.ShowIntradayCprOverlay"
                  ShowSuperTrendOverlay="ViewModel.ShowSuperTrendOverlay"
                  ShowSuperTrend725Overlay="ViewModel.ShowSuperTrend725Overlay"
                  ShowEma9Overlay="ViewModel.ShowEma9Overlay"
                  ShowEma20Overlay="ViewModel.ShowEma20Overlay"
                  ShowEma50Overlay="ViewModel.ShowEma50Overlay"
                  ShowEma200Overlay="ViewModel.ShowEma200Overlay"
                  ShowVwapOverlay="ViewModel.ShowVwapOverlay"
                  ShowPatternsOverlay="ViewModel.ShowPatternsOverlay"
                  Timeframe="ViewModel.SelectedTimeframe"
                  CssClass="@CssClass"
                  Width="@Width"
                  Height="@Height" />
<div class="chart-toolbar">
    <div class="timeframe-buttons">
        @foreach (var tf in Timeframes)
        {
            <button type="button"
                    class="btn tf-btn @(ViewModel.SelectedTimeframe == tf ? "active" : "")"
                    @onclick="() => ChangeTimeframeAsync(tf)">@tf</button>
        }
    </div>
    <ChartOverlayToggles ShowKeltnerToggle="@(ViewModel.SelectedTimeframe == "1m" || ViewModel.SelectedTimeframe == "5m")"
                         ShowIntradayStToggles="ViewModel.SupportsIntradayStOverlays"
                         ShowSt725Toggle="ViewModel.SupportsSt725Overlays"
                         Show5mStudyToggles="ViewModel.Supports5mStudyToggles"
                         ShowPoc="ViewModel.ShowPocOverlay"
                         ShowDayCpr="ViewModel.ShowPivotOverlay"
                         ShowCamarilla="ViewModel.ShowCamarillaOverlay"
                         ShowIntradayCpr="ViewModel.ShowIntradayCprOverlay"
                         ShowKeltner="ViewModel.ShowKeltnerOverlay"
                         ShowSuperTrend="ViewModel.ShowSuperTrendOverlay"
                         ShowSuperTrend725="ViewModel.ShowSuperTrend725Overlay"
                         ShowEma9="ViewModel.ShowEma9Overlay"
                         ShowEma20="ViewModel.ShowEma20Overlay"
                         ShowEma50="ViewModel.ShowEma50Overlay"
                         ShowEma200="ViewModel.ShowEma200Overlay"
                         ShowVwap="ViewModel.ShowVwapOverlay"
                         ShowPatterns="ViewModel.ShowPatternsOverlay"
                         ShowPocChanged="v => ViewModel.SetShowPocOverlay(v)"
                         ShowDayCprChanged="v => ViewModel.SetShowPivotOverlay(v)"
                         ShowCamarillaChanged="v => ViewModel.SetShowCamarillaOverlay(v)"
                         ShowIntradayCprChanged="v => ViewModel.SetShowIntradayCprOverlay(v)"
                         ShowKeltnerChanged="v => ViewModel.SetShowKeltnerOverlay(v)"
                         ShowSuperTrendChanged="v => ViewModel.SetShowSuperTrendOverlay(v)"
                         ShowSuperTrend725Changed="v => ViewModel.SetShowSuperTrend725Overlay(v)"
                         ShowEma9Changed="v => ViewModel.SetShowEma9Overlay(v)"
                         ShowEma20Changed="v => ViewModel.SetShowEma20Overlay(v)"
                         ShowEma50Changed="v => ViewModel.SetShowEma50Overlay(v)"
                         ShowEma200Changed="v => ViewModel.SetShowEma200Overlay(v)"
                         ShowVwapChanged="v => ViewModel.SetShowVwapOverlay(v)"
                         ShowPatternsChanged="v => ViewModel.SetShowPatternsOverlay(v)" />
</div>
<div class="chart-legend">
    @if (ViewModel.ShowSuperTrend725Overlay && ViewModel.SupportsSt725Overlays)
    {
        <span class="legend-item"><span class="legend-color st725"></span> ST(7,2.5)</span>
    }
    @if (ViewModel.ShowSuperTrendOverlay && ViewModel.SupportsIntradayStOverlays)
    {
        <span class="legend-item"><span class="legend-color buy"></span> ST(10,3) BUY</span>
        <span class="legend-item"><span class="legend-color sell"></span> ST(10,3) SELL</span>
    }
    @if (ViewModel.ShowEma9Overlay && ViewModel.SelectedTimeframe == "5m")
    {
        <span class="legend-item"><span class="legend-color ema9"></span> EMA 9</span>
    }
    @if (ViewModel.ShowEma20Overlay && ViewModel.SelectedTimeframe == "5m")
    {
        <span class="legend-item"><span class="legend-color ema20"></span> EMA 20</span>
    }
    @if (ViewModel.ShowEma50Overlay && ViewModel.SelectedTimeframe == "5m")
    {
        <span class="legend-item"><span class="legend-color ema50"></span> EMA 50</span>
    }
    @if (ViewModel.ShowEma200Overlay && ViewModel.SelectedTimeframe == "5m")
    {
        <span class="legend-item"><span class="legend-color ema200"></span> EMA 200</span>
    }
    @if (ViewModel.ShowVwapOverlay && ViewModel.SelectedTimeframe == "5m")
    {
        <span class="legend-item"><span class="legend-color vwap"></span> VWAP</span>
    }
    @if (ViewModel.ShowPatternsOverlay)
    {
        <span class="legend-item"><span class="legend-color pattern-buy"></span> Bull pattern</span>
        <span class="legend-item"><span class="legend-color pattern-sell"></span> Bear pattern</span>
        <span class="legend-item"><span class="legend-color pattern-neutral"></span> Neutral pattern</span>
    }
    @if (ViewModel.ShowPocOverlay)
    {
        <span class="legend-item"><span class="legend-color poc"></span> POC / VA</span>
    }
    @if (ViewModel.ShowPivotOverlay)
    {
        <span class="legend-item"><span class="legend-color pivot"></span> Day CPR (prev day)</span>
    }
    @if (ViewModel.ShowIntradayCprOverlay)
    {
        <span class="legend-item"><span class="legend-color cpr-tc"></span> 1m CPR on chart — TC / CPR / BC per 15m</span>
    }
    @if (ViewModel.ShowCamarillaOverlay)
    {
        <span class="legend-item"><span class="legend-color camarilla"></span> Camarilla</span>
    }
    @if (ViewModel.ShowKeltnerOverlay && (ViewModel.SelectedTimeframe == "1m" || ViewModel.SelectedTimeframe == "5m"))
    {
        <span class="legend-item"><span class="legend-color keltner"></span> Keltner (20, 1.5/2.0)</span>
    }
</div>
@if (!string.IsNullOrEmpty(ViewModel.ChartDataMessage))
{
    <div class="chart-meta @(ViewModel.IsChartFromZerodha ? "zerodha" : "warning")">
        @ViewModel.ChartDataMessage
    </div>
}
@if (ShowLastCandleSummary && !string.IsNullOrEmpty(ViewModel.LastCandleSummary))
{
    <div class="chart-meta">Last bar: @ViewModel.LastCandleSummary</div>
}

@code {
    private static readonly string[] DefaultTimeframes = ["1m", "5m", "15m", "1H"];

    [Parameter, EditorRequired] public DashboardViewModel ViewModel { get; set; } = default!;
    [Parameter] public string CanvasId { get; set; } = "priceChart";
    [Parameter] public int Width { get; set; } = 900;
    [Parameter] public int Height { get; set; } = 420;
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public bool ShowLastCandleSummary { get; set; } = true;
    [Parameter] public string[] Timeframes { get; set; } = DefaultTimeframes;

    private string ChartSurfaceKey =>
        $"{CanvasId}|{ViewModel.SelectedSymbol}|{ViewModel.SelectedTimeframe}";

    private Task ChangeTimeframeAsync(string timeframe) => ViewModel.ChangeTimeframeAsync(timeframe);
}
