@namespace PGOne.Components

<div class="chart-overlay-toggles">
    <button type="button"
            class="btn overlay-toggle @(ShowPoc ? "active" : "")"
            @onclick="TogglePocAsync">
        POC
    </button>
    <button type="button"
            class="btn overlay-toggle @(ShowDayCpr ? "active" : "")"
            @onclick="ToggleDayCprAsync">
        CPR
    </button>
    @if (ShowIntradayCprToggle)
    {
        <button type="button"
                class="btn overlay-toggle @(ShowIntradayCpr ? "active" : "")"
                @onclick="ToggleIntradayCprAsync">
            1m CPR
        </button>
    }
    <button type="button"
            class="btn overlay-toggle @(ShowCamarilla ? "active" : "")"
            @onclick="ToggleCamarillaAsync">
        Camarilla
    </button>
    @if (ShowKeltnerToggle)
    {
        <button type="button"
                class="btn overlay-toggle @(ShowKeltner ? "active" : "")"
                @onclick="ToggleKeltnerAsync">
            Keltner
        </button>
    }
</div>

@code {
    [Parameter] public bool ShowPoc { get; set; } = true;
    [Parameter] public bool ShowDayCpr { get; set; } = true;
    [Parameter] public bool ShowCamarilla { get; set; } = true;
    [Parameter] public bool ShowIntradayCprToggle { get; set; }
    [Parameter] public bool ShowIntradayCpr { get; set; } = true;
    [Parameter] public bool ShowKeltnerToggle { get; set; }
    [Parameter] public bool ShowKeltner { get; set; } = true;
    [Parameter] public EventCallback<bool> ShowPocChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowDayCprChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowCamarillaChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowIntradayCprChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowKeltnerChanged { get; set; }

    private async Task TogglePocAsync() => await ShowPocChanged.InvokeAsync(!ShowPoc);

    private async Task ToggleDayCprAsync() => await ShowDayCprChanged.InvokeAsync(!ShowDayCpr);

    private async Task ToggleIntradayCprAsync() => await ShowIntradayCprChanged.InvokeAsync(!ShowIntradayCpr);

    private async Task ToggleCamarillaAsync() => await ShowCamarillaChanged.InvokeAsync(!ShowCamarilla);

    private async Task ToggleKeltnerAsync() => await ShowKeltnerChanged.InvokeAsync(!ShowKeltner);
}
