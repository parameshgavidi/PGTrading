@namespace PGOne.Components

<div class="chart-overlay-toggles">
    <button type="button"
            class="btn overlay-toggle @(ShowPoc ? "active" : "")"
            @onclick="TogglePocAsync">
        POC
    </button>
    <button type="button"
            class="btn overlay-toggle @(ShowDayCpr ? "active" : "")"
            @onclick="ToggleDayCprAsync">
        Day CPR
    </button>
    @if (ShowIntradayCprToggle)
    {
        <button type="button"
                class="btn overlay-toggle @(ShowIntradayCpr ? "active" : "")"
                @onclick="ToggleIntradayCprAsync">
            1m CPR
        </button>
    }
    <button type="button"
            class="btn overlay-toggle @(ShowCamarilla ? "active" : "")"
            @onclick="ToggleCamarillaAsync">
        Camarilla
    </button>
    @if (ShowKeltnerToggle)
    {
        <button type="button"
                class="btn overlay-toggle @(ShowKeltner ? "active" : "")"
                @onclick="ToggleKeltnerAsync">
            Keltner
        </button>
    }
    @if (ShowSt725Toggle)
    {
        <button type="button"
                class="btn overlay-toggle @(ShowSuperTrend725 ? "active" : "")"
                @onclick="ToggleSuperTrend725Async">
            ST 7,2.5
        </button>
    }
    @if (ShowIntradayStToggles)
    {
        <button type="button"
                class="btn overlay-toggle @(ShowSuperTrend ? "active" : "")"
                @onclick="ToggleSuperTrendAsync">
            ST 10,3
        </button>
    }
    @if (Show5mStudyToggles)
    {
        <button type="button"
                class="btn overlay-toggle @(ShowEma20 ? "active" : "")"
                @onclick="ToggleEma20Async">
            EMA 20
        </button>
        <button type="button"
                class="btn overlay-toggle @(ShowVwap ? "active" : "")"
                @onclick="ToggleVwapAsync">
            VWAP
        </button>
    }
</div>

@code {
    [Parameter] public bool ShowPoc { get; set; } = true;
    [Parameter] public bool ShowDayCpr { get; set; }
    [Parameter] public bool ShowCamarilla { get; set; }
    [Parameter] public bool ShowIntradayCprToggle { get; set; }
    [Parameter] public bool ShowIntradayCpr { get; set; }
    [Parameter] public bool ShowKeltnerToggle { get; set; }
    [Parameter] public bool ShowKeltner { get; set; }
    [Parameter] public bool ShowIntradayStToggles { get; set; }
    [Parameter] public bool ShowSt725Toggle { get; set; }
    [Parameter] public bool Show5mStudyToggles { get; set; }
    [Parameter] public bool ShowSuperTrend { get; set; }
    [Parameter] public bool ShowSuperTrend725 { get; set; }
    [Parameter] public bool ShowEma20 { get; set; }
    [Parameter] public bool ShowVwap { get; set; }
    [Parameter] public EventCallback<bool> ShowPocChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowDayCprChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowCamarillaChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowIntradayCprChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowKeltnerChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowSuperTrendChanged { get; set; }
    [Parameter] public EventCallback<bool> ShowSuperTrend725Changed { get; set; }
    [Parameter] public EventCallback<bool> ShowEma20Changed { get; set; }
    [Parameter] public EventCallback<bool> ShowVwapChanged { get; set; }

    private async Task TogglePocAsync() => await ShowPocChanged.InvokeAsync(!ShowPoc);

    private async Task ToggleDayCprAsync() => await ShowDayCprChanged.InvokeAsync(!ShowDayCpr);

    private async Task ToggleIntradayCprAsync() => await ShowIntradayCprChanged.InvokeAsync(!ShowIntradayCpr);

    private async Task ToggleCamarillaAsync() => await ShowCamarillaChanged.InvokeAsync(!ShowCamarilla);

    private async Task ToggleKeltnerAsync() => await ShowKeltnerChanged.InvokeAsync(!ShowKeltner);

    private async Task ToggleSuperTrendAsync() => await ShowSuperTrendChanged.InvokeAsync(!ShowSuperTrend);

    private async Task ToggleSuperTrend725Async() => await ShowSuperTrend725Changed.InvokeAsync(!ShowSuperTrend725);

    private async Task ToggleEma20Async() => await ShowEma20Changed.InvokeAsync(!ShowEma20);

    private async Task ToggleVwapAsync() => await ShowVwapChanged.InvokeAsync(!ShowVwap);
}
