@namespace PGOne.Components
@using PGOne.Models
@inject IJSRuntime JS

<div class="chart-area @CssClass">
    <div class="chart-zoom-controls">
        <button type="button" class="zoom-btn" title="Zoom in" @onclick="ZoomIn">+</button>
        <button type="button" class="zoom-btn" title="Zoom out" @onclick="ZoomOut">−</button>
        <button type="button" class="zoom-btn" title="Reset zoom" @onclick="ResetZoom">⟳</button>
    </div>
    <canvas id="@CanvasId" width="@Width" height="@Height"></canvas>
</div>

@code {
    [Parameter] public string CanvasId { get; set; } = "priceChart";
    [Parameter] public List<Candle> Candles { get; set; } = new();
    [Parameter] public int ChartVersion { get; set; }
    [Parameter] public string Timeframe { get; set; } = "5m";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public int Width { get; set; } = 800;
    [Parameter] public int Height { get; set; } = 350;

    private int _lastRenderedVersion = -1;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Candles.Count == 0 || ChartVersion == _lastRenderedVersion)
            return;

        _lastRenderedVersion = ChartVersion;
        await RenderAsync();
    }

    private async Task ZoomIn() => await InvokeSafe("pgOneChart.zoom", CanvasId, 1.3);
    private async Task ZoomOut() => await InvokeSafe("pgOneChart.zoom", CanvasId, 1 / 1.3);
    private async Task ResetZoom() => await InvokeSafe("pgOneChart.resetZoom", CanvasId);

    private async Task InvokeSafe(string fn, params object[] args)
    {
        try { await JS.InvokeVoidAsync(fn, args); }
        catch { /* WebView not ready */ }
    }

    private async Task RenderAsync()
    {
        var payload = Candles.Select(c => new
        {
            time = c.Timestamp.ToString("o"),
            open = c.Open,
            high = c.High,
            low = c.Low,
            close = c.Close,
            superTrend = c.SuperTrend,
            keltnerUpperInner = c.KeltnerUpperInner,
            keltnerLowerInner = c.KeltnerLowerInner,
            keltnerUpperOuter = c.KeltnerUpperOuter,
            keltnerLowerOuter = c.KeltnerLowerOuter,
            keltnerMid = c.KeltnerMid,
            vwap = c.Vwap
        }).ToList();

        await InvokeSafe("pgOneChart.drawCandlestickChart", CanvasId, payload, Timeframe);
    }
}
