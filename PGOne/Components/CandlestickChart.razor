@namespace PGOne.Components
@using System.Text.Json
@using PGOne.Models
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="chart-area @CssClass">
    <div class="chart-zoom-controls">
        <button type="button" class="zoom-btn" title="Zoom in" @onclick="ZoomIn">+</button>
        <button type="button" class="zoom-btn" title="Zoom out" @onclick="ZoomOut">−</button>
        <button type="button" class="zoom-btn" title="Reset zoom" @onclick="ResetZoom">⟳</button>
    </div>
    <canvas id="@CanvasId" width="@Width" height="@Height"></canvas>
</div>

@code {
    private static readonly JsonSerializerOptions ChartJson = new()
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    [Parameter] public string CanvasId { get; set; } = "priceChart";
    [Parameter] public List<Candle> Candles { get; set; } = new();
    [Parameter] public int ChartVersion { get; set; }
    [Parameter] public int OverlayVersion { get; set; }
    [Parameter] public MultiTimeframeAnalysis? Analysis { get; set; }
    [Parameter] public IReadOnlyList<IntradayCprSegment> CprSegments { get; set; } = Array.Empty<IntradayCprSegment>();
    [Parameter] public bool ShowPocLevels { get; set; } = true;
    [Parameter] public bool ShowPivotLevels { get; set; } = true;
    [Parameter] public bool ShowCamarillaLevels { get; set; } = true;
    [Parameter] public bool ShowKeltnerLevels { get; set; } = true;
    [Parameter] public bool ShowIntradayCprLevels { get; set; } = true;
    [Parameter] public bool ShowSuperTrendOverlay { get; set; }
    [Parameter] public bool ShowSuperTrend725Overlay { get; set; }
    [Parameter] public bool ShowEma20Overlay { get; set; }
    [Parameter] public bool ShowVwapOverlay { get; set; }
    [Parameter] public string Timeframe { get; set; } = "5m";
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public int Width { get; set; } = 800;
    [Parameter] public int Height { get; set; } = 350;

    private int _lastRenderedVersion = -1;
    private int _lastOverlayVersion = -1;
    private string _lastTimeframe = "5m";
    private bool _lastShowPoc;
    private bool _lastShowPivot;
    private bool _lastShowCamarilla;
    private bool _lastShowKeltner;
    private bool _lastShowIntradayCpr;
    private bool _lastShowSuperTrend;
    private bool _lastShowSuperTrend725;
    private bool _lastShowEma20;
    private bool _lastShowVwapOverlay;
    private int _lastCprSegmentCount;
    private string _lastCprSegmentKey = string.Empty;
    private int _pendingRenderRetries;
    private CancellationTokenSource? _retryCts;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Candles.Count == 0)
            return;

        var segmentKey = BuildCprSegmentKey();

        if (ChartVersion == _lastRenderedVersion
            && OverlayVersion == _lastOverlayVersion
            && Timeframe == _lastTimeframe
            && ShowPocLevels == _lastShowPoc
            && ShowPivotLevels == _lastShowPivot
            && ShowCamarillaLevels == _lastShowCamarilla
            && ShowKeltnerLevels == _lastShowKeltner
            && ShowIntradayCprLevels == _lastShowIntradayCpr
            && ShowSuperTrendOverlay == _lastShowSuperTrend
            && ShowSuperTrend725Overlay == _lastShowSuperTrend725
            && ShowEma20Overlay == _lastShowEma20
            && ShowVwapOverlay == _lastShowVwapOverlay
            && CprSegments.Count == _lastCprSegmentCount
            && segmentKey == _lastCprSegmentKey)
            return;

        if (!await RenderAsync())
        {
            ScheduleRenderRetry();
            return;
        }

        MarkRenderSuccessful(segmentKey);
    }

    private void MarkRenderSuccessful(string segmentKey)
    {
        _lastRenderedVersion = ChartVersion;
        _lastOverlayVersion = OverlayVersion;
        _lastTimeframe = Timeframe;
        _lastShowPoc = ShowPocLevels;
        _lastShowPivot = ShowPivotLevels;
        _lastShowCamarilla = ShowCamarillaLevels;
        _lastShowKeltner = ShowKeltnerLevels;
        _lastShowIntradayCpr = ShowIntradayCprLevels;
        _lastShowSuperTrend = ShowSuperTrendOverlay;
        _lastShowSuperTrend725 = ShowSuperTrend725Overlay;
        _lastShowEma20 = ShowEma20Overlay;
        _lastShowVwapOverlay = ShowVwapOverlay;
        _lastCprSegmentCount = CprSegments.Count;
        _lastCprSegmentKey = segmentKey;
        _pendingRenderRetries = 0;
    }

    private bool IsOverlayOnlyChange()
    {
        return ChartVersion == _lastRenderedVersion
            && OverlayVersion != _lastOverlayVersion
            && Timeframe == _lastTimeframe
            && CprSegments.Count == _lastCprSegmentCount
            && BuildCprSegmentKey() == _lastCprSegmentKey;
    }

    private bool IsStudyOverlayToggleOnly()
    {
        return ShowPocLevels == _lastShowPoc
            && ShowPivotLevels == _lastShowPivot
            && ShowCamarillaLevels == _lastShowCamarilla
            && ShowKeltnerLevels == _lastShowKeltner
            && ShowIntradayCprLevels == _lastShowIntradayCpr;
    }

    private bool IsVwapOverlayToggleOnly()
    {
        return ShowVwapOverlay != _lastShowVwapOverlay
            && ShowEma20Overlay == _lastShowEma20
            && ShowSuperTrendOverlay == _lastShowSuperTrend
            && ShowSuperTrend725Overlay == _lastShowSuperTrend725;
    }

    private bool IsEma20OverlayToggleOnly()
    {
        return ShowEma20Overlay != _lastShowEma20
            && ShowVwapOverlay == _lastShowVwapOverlay
            && ShowSuperTrendOverlay == _lastShowSuperTrend
            && ShowSuperTrend725Overlay == _lastShowSuperTrend725;
    }

    private bool IsSt725OverlayToggleOnly()
    {
        return ShowSuperTrend725Overlay != _lastShowSuperTrend725
            && ShowSuperTrendOverlay == _lastShowSuperTrend
            && ShowEma20Overlay == _lastShowEma20
            && ShowVwapOverlay == _lastShowVwapOverlay;
    }

    private bool IsIntradayCprToggleOnly()
    {
        return ShowIntradayCprLevels != _lastShowIntradayCpr
            && ShowPocLevels == _lastShowPoc
            && ShowPivotLevels == _lastShowPivot
            && ShowCamarillaLevels == _lastShowCamarilla
            && ShowKeltnerLevels == _lastShowKeltner
            && ShowSuperTrendOverlay == _lastShowSuperTrend
            && ShowSuperTrend725Overlay == _lastShowSuperTrend725
            && ShowEma20Overlay == _lastShowEma20
            && ShowVwapOverlay == _lastShowVwapOverlay;
    }

    private void ScheduleRenderRetry()
    {
        if (_pendingRenderRetries >= 12)
            return;

        _pendingRenderRetries++;
        _retryCts?.Cancel();
        _retryCts = new CancellationTokenSource();
        var token = _retryCts.Token;
        _ = RetryRenderAfterDelayAsync(token);
    }

    private async Task RetryRenderAfterDelayAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(150 + _pendingRenderRetries * 80, token);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
            // superseded by a newer retry
        }
    }

    private string BuildCprSegmentKey() =>
        string.Join('|', CprSegments.Select(s => $"{s.Start:O}:{s.Pivot}:{s.Tc}:{s.Bc}"));

    private async Task ZoomIn() => await InvokeSafe("pgOneChart.zoom", CanvasId, 1.3);
    private async Task ZoomOut() => await InvokeSafe("pgOneChart.zoom", CanvasId, 1 / 1.3);
    private async Task ResetZoom() => await InvokeSafe("pgOneChart.resetZoom", CanvasId);

    private async Task InvokeSafe(string fn, params object[] args)
    {
        try { await JS.InvokeVoidAsync(fn, args); }
        catch { /* WebView not ready */ }
    }

    private async Task<bool> RenderAsync()
    {
        if (!await WaitForChartJsAsync())
            return false;

        var studyFlags = BuildStudyOverlayInts();
        var segmentsJson = BuildCprSegmentsJson();

        if (IsOverlayOnlyChange() && IsIntradayCprToggleOnly())
        {
            if (await TrySetIntradayCprOverlayAsync(ShowIntradayCprLevels, segmentsJson))
                return true;
        }

        if (IsOverlayOnlyChange() && IsStudyOverlayToggleOnly())
        {
            if (IsVwapOverlayToggleOnly())
            {
                var vwapOn = BuildStudyOverlayInts().ShowVwap;
                if (await TrySetVwapOverlayAsync(vwapOn))
                    return true;
            }

            if (IsEma20OverlayToggleOnly())
            {
                var emaOn = BuildStudyOverlayInts().ShowEma20;
                if (await TrySetEma20OverlayAsync(emaOn))
                    return true;
            }

            if (IsSt725OverlayToggleOnly())
            {
                var st725On = BuildStudyOverlayInts().ShowSt725;
                if (await TrySetSt725OverlayAsync(st725On))
                    return true;
            }

            if (await TrySetStudyOverlaysAsync(studyFlags))
                return true;
        }

        var segmentPayload = BuildCprSegmentPayload();

        var supportsIntradayCpr = Timeframe == "1m";
        var showIntradayCpr = supportsIntradayCpr && ShowIntradayCprLevels && segmentPayload.Count > 0;

        var overlayOptions = new
        {
            showPoc = ShowPocLevels ? 1 : 0,
            showPivot = ShowPivotLevels ? 1 : 0,
            showCamarilla = ShowCamarillaLevels ? 1 : 0,
            showIntradaCpr = showIntradayCpr ? 1 : 0,
            intradayCpr = segmentPayload,
            showKeltner = ShowKeltnerLevels ? 1 : 0,
            showVwap = ShowVwapOverlay ? 1 : 0,
            showSuperTrend = ShowSuperTrendOverlay ? 1 : 0,
            showSuperTrend725 = ShowSuperTrend725Overlay ? 1 : 0,
            showEma20 = ShowEma20Overlay ? 1 : 0
        };

        var payload = Candles.Select(c => new
        {
            time = ChartJsTime.ToEpochMs(c.Timestamp),
            open = (double)c.Open,
            high = (double)c.High,
            low = (double)c.Low,
            close = (double)c.Close,
            volume = (double)c.Volume,
            superTrend = ToJsDouble(c.SuperTrend),
            superTrend725 = ToJsDouble(c.SuperTrendEntry),
            superTrendEntry = ToJsDouble(c.SuperTrendEntry),
            st725 = ToJsDouble(c.SuperTrendEntry),
            keltnerUpperInner = ToJsDouble(c.KeltnerUpperInner),
            keltnerLowerInner = ToJsDouble(c.KeltnerLowerInner),
            keltnerUpperOuter = ToJsDouble(c.KeltnerUpperOuter),
            keltnerLowerOuter = ToJsDouble(c.KeltnerLowerOuter),
            keltnerMid = ToJsDouble(c.KeltnerMid),
            vwap = ToJsDouble(c.Vwap),
            vwapLine = ToJsDouble(c.Vwap),
            ema20 = ToJsDouble(c.Ema20),
            ema20Line = ToJsDouble(c.Ema20)
        }).ToList();

        var levels = BuildLevelPayload();
        var pocToday = !supportsIntradayCpr && ShowPocLevels && Analysis?.VolumeProfile.HasData == true
            ? (double)Analysis.VolumeProfile.Poc
            : 0d;

        var candlesJson = JsonSerializer.Serialize(payload, ChartJson);
        var levelsJson = JsonSerializer.Serialize(levels, ChartJson);
        var overlaysJson = JsonSerializer.Serialize(overlayOptions, ChartJson);

        for (var attempt = 0; attempt < 12; attempt++)
        {
            try
            {
                var ok = await JS.InvokeAsync<bool>(
                    "pgOneDrawCandles",
                    CanvasId,
                    candlesJson,
                    Timeframe,
                    levelsJson,
                    pocToday,
                    overlaysJson,
                    studyFlags.ShowVwap,
                    studyFlags.ShowEma20,
                    studyFlags.ShowSt725,
                    studyFlags.ShowSt103);
                if (ok)
                {
                    await SyncStudyOverlaysAsync(studyFlags);
                    if (Timeframe == "1m")
                        await SyncIntradayCprOverlayAsync(ShowIntradayCprLevels, segmentsJson);
                    return true;
                }
            }
            catch when (attempt < 11)
            {
                await Task.Delay(100 + attempt * 80);
            }
        }

        return false;
    }

    private (int ShowVwap, int ShowEma20, int ShowSt725, int ShowSt103) BuildStudyOverlayInts()
    {
        return (
            ShowVwapOverlay ? 1 : 0,
            ShowEma20Overlay ? 1 : 0,
            ShowSuperTrend725Overlay ? 1 : 0,
            ShowSuperTrendOverlay ? 1 : 0);
    }

    private List<object> BuildCprSegmentPayload() =>
        CprSegments.Select(s => new
        {
            start = ChartJsTime.ToEpochMs(s.Start),
            end = ChartJsTime.ToEpochMs(s.End),
            pivot = (double)s.Pivot,
            tc = (double)s.Tc,
            bc = (double)s.Bc
        }).Cast<object>().ToList();

    private string BuildCprSegmentsJson() =>
        JsonSerializer.Serialize(BuildCprSegmentPayload(), ChartJson);

    private async Task SyncIntradayCprOverlayAsync(bool show, string segmentsJson)
    {
        try
        {
            await JS.InvokeAsync<bool>(
                "pgOneSetIntradayCprOverlay",
                CanvasId,
                show ? 1 : 0,
                segmentsJson);
        }
        catch
        {
            // Non-fatal sync after full draw
        }
    }

    private async Task<bool> TrySetIntradayCprOverlayAsync(bool show, string segmentsJson)
    {
        for (var attempt = 0; attempt < 6; attempt++)
        {
            try
            {
                var hasState = await JS.InvokeAsync<bool>("pgOneChartHasState", CanvasId);
                if (!hasState)
                    return false;

                return await JS.InvokeAsync<bool>(
                    "pgOneSetIntradayCprOverlay",
                    CanvasId,
                    show ? 1 : 0,
                    segmentsJson);
            }
            catch when (attempt < 5)
            {
                await Task.Delay(80 + attempt * 60);
            }
        }

        return false;
    }

    private async Task SyncStudyOverlaysAsync((int ShowVwap, int ShowEma20, int ShowSt725, int ShowSt103) flags)
    {
        try
        {
            await JS.InvokeAsync<bool>(
                "pgOneSetStudyOverlays",
                CanvasId,
                flags.ShowVwap,
                flags.ShowEma20,
                flags.ShowSt725,
                flags.ShowSt103);
        }
        catch
        {
            // Non-fatal: full draw already ran; this syncs overlay flags + recomputes studies.
        }
    }

    private async Task<bool> TrySetVwapOverlayAsync(int showVwap)
    {
        for (var attempt = 0; attempt < 6; attempt++)
        {
            try
            {
                var hasState = await JS.InvokeAsync<bool>("pgOneChartHasState", CanvasId);
                if (!hasState)
                    return false;

                return await JS.InvokeAsync<bool>("pgOneSetVwapOverlay", CanvasId, showVwap);
            }
            catch when (attempt < 5)
            {
                await Task.Delay(80 + attempt * 60);
            }
        }

        return false;
    }

    private async Task<bool> TrySetEma20OverlayAsync(int showEma20)
    {
        for (var attempt = 0; attempt < 6; attempt++)
        {
            try
            {
                var hasState = await JS.InvokeAsync<bool>("pgOneChartHasState", CanvasId);
                if (!hasState)
                    return false;

                return await JS.InvokeAsync<bool>("pgOneSetEma20Overlay", CanvasId, showEma20);
            }
            catch when (attempt < 5)
            {
                await Task.Delay(80 + attempt * 60);
            }
        }

        return false;
    }

    private async Task<bool> TrySetSt725OverlayAsync(int showSt725)
    {
        for (var attempt = 0; attempt < 6; attempt++)
        {
            try
            {
                var hasState = await JS.InvokeAsync<bool>("pgOneChartHasState", CanvasId);
                if (!hasState)
                    return false;

                return await JS.InvokeAsync<bool>("pgOneSetSt725Overlay", CanvasId, showSt725);
            }
            catch when (attempt < 5)
            {
                await Task.Delay(80 + attempt * 60);
            }
        }

        return false;
    }

    private async Task<bool> TrySetStudyOverlaysAsync((int ShowVwap, int ShowEma20, int ShowSt725, int ShowSt103) flags)
    {
        for (var attempt = 0; attempt < 6; attempt++)
        {
            try
            {
                var hasState = await JS.InvokeAsync<bool>("pgOneChartHasState", CanvasId);
                if (!hasState)
                    return false;

                return await JS.InvokeAsync<bool>(
                    "pgOneSetStudyOverlays",
                    CanvasId,
                    flags.ShowVwap,
                    flags.ShowEma20,
                    flags.ShowSt725,
                    flags.ShowSt103);
            }
            catch when (attempt < 5)
            {
                await Task.Delay(80 + attempt * 60);
            }
        }

        return false;
    }

    private async Task<bool> WaitForChartJsAsync()
    {
        for (var attempt = 0; attempt < 20; attempt++)
        {
            try
            {
                if (await JS.InvokeAsync<bool>("pgOneChartReady"))
                    return true;
            }
            catch when (attempt < 19)
            {
                await Task.Delay(80 + attempt * 40);
            }
        }

        return false;
    }

    private static double? ToJsDouble(decimal? value) =>
        value.HasValue ? (double)value.Value : null;

    private List<object> BuildLevelPayload()
    {
        if (Analysis is null)
            return new List<object>();

        return SupportResistanceLadderBuilder.Build(Analysis)
            .Where(row => row.Group switch
            {
                "cam" => ShowCamarillaLevels,
                "cpr" => ShowPivotLevels,
                "today" or "prev" => ShowPocLevels,
                _ => true
            })
            .Select(row => new
            {
                label = row.Label,
                price = (double)row.Price,
                group = row.Group,
                kind = row.CssClass
            })
            .Cast<object>()
            .ToList();
    }

    public async ValueTask DisposeAsync()
    {
        _retryCts?.Cancel();
        _retryCts?.Dispose();
    }
}
