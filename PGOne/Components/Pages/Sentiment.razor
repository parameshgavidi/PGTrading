@page "/sentiment"
@inject SentimentViewModel ViewModel
@implements IDisposable

<div class="page-container">
    @if (ViewModel.Results.Count > 0)
    {
        <div class="card" style="margin-bottom: 12px;">
            <div class="card-header">Market Headlines</div>
            <div class="news-list">
                @foreach (var headline in GetTopHeadlines())
                {
                    <div class="news-item">
                        @GetHeadlineIcon(headline.Label) @headline.Headline
                    </div>
                }
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">
            <h2>Sentiment Analysis — NSE Stocks</h2>
            <div class="button-row">
                <button class="btn btn-secondary" @onclick="ScanTopTenAsync" disabled="@ViewModel.IsScanning">
                    Scan Top 10
                </button>
                <button class="btn btn-secondary" @onclick="ScanSymbolsAsync" disabled="@ViewModel.IsScanning">
                    Scan Nifty 50
                </button>
                <button class="btn btn-primary" @onclick="ScanNewsFeedsAsync" disabled="@ViewModel.IsScanning">
                    @(ViewModel.IsScanning ? "Scanning..." : "Scan News Feeds")
                </button>
            </div>
        </div>

        <p class="text-secondary">
            Scans <strong>MoneyControl</strong>, <strong>Economic Times</strong>, <strong>LiveMint</strong>, and
            <strong>Google News</strong> RSS feeds, matches mentioned stocks against the live
            <strong>NSE equity list</strong>, and classifies sentiment using
            <strong>FinBERT</strong> (ProsusAI/finbert) — the leading free financial NLP model.
        </p>

        @if (!string.IsNullOrEmpty(ViewModel.ProgressMessage))
        {
            <div class="status-message">@ViewModel.ProgressMessage</div>
        }

        @if (!ViewModel.IsConnected && ViewModel.Results.Count > 0)
        {
            <div class="holdings-banner warning">Connect to Zerodha in Settings to place orders.</div>
        }

        @if (ViewModel.Results.Count > 0)
        {
            <div class="sentiment-toolbar">
                <div class="sentiment-summary">
                    <span class="summary-pill buy">Bullish: @ViewModel.BullishCount</span>
                    <span class="summary-pill sell">Bearish: @ViewModel.BearishCount</span>
                    <span class="summary-pill neutral">Neutral: @ViewModel.NeutralCount</span>
                </div>
                <div class="sentiment-filter">
                    <label for="sentiment-filter">Filter</label>
                    <select id="sentiment-filter" class="form-input" @bind="_filter" @bind:after="OnFilterChanged">
                        <option value="@SentimentFilter.All">All (@ViewModel.Results.Count)</option>
                        <option value="@SentimentFilter.Bullish">Bullish (@ViewModel.BullishCount)</option>
                        <option value="@SentimentFilter.Bearish">Bearish (@ViewModel.BearishCount)</option>
                        <option value="@SentimentFilter.Neutral">Neutral (@ViewModel.NeutralCount)</option>
                    </select>
                </div>
            </div>

            <table class="data-table sentiment-table">
                <thead>
                    <tr>
                        <th>Symbol</th>
                        <th>Prediction</th>
                        <th>Confidence</th>
                        <th>Reason</th>
                        <th>Sources</th>
                        <th>+ve</th>
                        <th>-ve</th>
                        <th>Neutral</th>
                        <th>News</th>
                        <th>Articles</th>
                        <th>Order</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in ViewModel.FilteredResults)
                    {
                        <tr>
                            <td><strong>@row.Symbol</strong></td>
                            <td class="@GetPredictionClass(row.Prediction)">
                                <span class="sentiment-badge @GetPredictionClass(row.Prediction)">
                                    @GetPredictionLabel(row.Prediction)
                                </span>
                            </td>
                            <td>@(row.Confidence > 0 ? $"{row.Confidence:P0}" : "—")</td>
                            <td class="sentiment-reason">
                                @if (!string.IsNullOrEmpty(row.Reason))
                                {
                                    @row.Reason
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td>
                                @if (row.Sources.Count > 0)
                                {
                                    <span>@string.Join(", ", row.Sources)</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td class="buy">@row.PositiveCount</td>
                            <td class="sell">@row.NegativeCount</td>
                            <td class="neutral">@row.NeutralCount</td>
                            <td>@row.NewsCount</td>
                            <td>
                                @if (!string.IsNullOrEmpty(row.Error))
                                {
                                    <span class="text-secondary">@row.Error</span>
                                }
                                else
                                {
                                    @if (!string.IsNullOrEmpty(row.Warning))
                                    {
                                        <div class="text-secondary" style="margin-bottom: 6px;">@row.Warning</div>
                                    }
                                    @if (row.Headlines.Count > 0)
                                    {
                                        <ul class="sentiment-headlines">
                                            @foreach (var headline in row.Headlines)
                                            {
                                                <li>
                                                    <span class="source-tag">@headline.Source</span>
                                                    <span class="@GetLabelClass(headline.Label)">@headline.Label</span>
                                                    <span class="headline-text">@headline.Headline</span>
                                                    <span class="headline-score">(@headline.Score:P0})</span>
                                                    @if (!string.IsNullOrEmpty(headline.Reason))
                                                    {
                                                        <div class="headline-reason">@headline.Reason</div>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                }
                            </td>
                            <td class="sentiment-order-cell">
                                @if (row.Prediction != SentimentPrediction.Neutral)
                                {
                                    <button class="btn btn-primary btn-sm"
                                            disabled="@(!ViewModel.IsConnected)"
                                            @onclick="() => OpenOrderModal(row)">
                                        Place Order
                                    </button>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                                @if (!string.IsNullOrEmpty(row.OrderMessage))
                                {
                                    <div class="order-message">@row.OrderMessage</div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else if (!ViewModel.IsScanning)
        {
            <div class="empty-state">
                Click <strong>Scan News Feeds</strong> to discover NSE stocks mentioned across MoneyControl, ET, LiveMint, and Google News.
                Use <strong>Scan Nifty 50</strong> for targeted symbol coverage.
                Add a free Hugging Face token in <strong>Settings</strong> for FinBERT analysis (keyword fallback is used without a token).
            </div>
        }
    </div>
</div>

@if (_showOrderModal && _selectedRow is not null)
{
    <div class="modal-overlay" @onclick="CloseOrderModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h3>Place Limit Order</h3>
                <button class="modal-close" @onclick="CloseOrderModal">×</button>
            </div>
            <div class="modal-body">
                <div class="modal-detail-row">
                    <span class="label">Symbol</span>
                    <span class="value"><strong>@_selectedRow.Symbol</strong></span>
                </div>
                <div class="modal-detail-row">
                    <span class="label">Side</span>
                    <span class="value @GetPredictionClass(_selectedRow.Prediction)">
                        @(_selectedRow.Prediction == SentimentPrediction.Bullish ? "BUY" : "SELL")
                    </span>
                </div>
                <div class="modal-detail-row">
                    <span class="label">Type</span>
                    <span class="value">LIMIT MIS (NSE)</span>
                </div>
                <div class="form-row">
                    <label for="order-qty">Quantity</label>
                    <input id="order-qty"
                           type="number"
                           min="1"
                           class="form-input"
                           @bind="_orderQuantity"
                           @bind:event="oninput" />
                </div>
                @if (!string.IsNullOrEmpty(_orderMessage))
                {
                    <div class="status-message">@_orderMessage</div>
                }
            </div>
            <div class="modal-actions">
                <button class="btn btn-secondary" @onclick="CloseOrderModal">Cancel</button>
                <button class="btn btn-primary"
                        disabled="@_isPlacingOrder"
                        @onclick="SubmitOrderAsync">
                    @(_isPlacingOrder ? "Placing..." : "Place Order")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private SentimentFilter _filter = SentimentFilter.All;
    private bool _showOrderModal;
    private bool _isPlacingOrder;
    private StockSentimentResult? _selectedRow;
    private int _orderQuantity = 1;
    private string _orderMessage = string.Empty;

    protected override void OnInitialized()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        _filter = ViewModel.Filter;
    }

    private void OnFilterChanged()
    {
        ViewModel.Filter = _filter;
    }

    private async Task ScanNewsFeedsAsync() => await ViewModel.ScanNewsFeedsAsync();
    private async Task ScanSymbolsAsync() => await ViewModel.ScanSymbolsAsync();
    private async Task ScanTopTenAsync() => await ViewModel.ScanTopTenAsync();

    private void OpenOrderModal(StockSentimentResult row)
    {
        _selectedRow = row;
        _orderQuantity = 1;
        _orderMessage = string.Empty;
        _showOrderModal = true;
    }

    private void CloseOrderModal()
    {
        _showOrderModal = false;
        _selectedRow = null;
        _orderMessage = string.Empty;
        _isPlacingOrder = false;
    }

    private async Task SubmitOrderAsync()
    {
        if (_selectedRow is null)
            return;

        _isPlacingOrder = true;
        _orderMessage = string.Empty;

        try
        {
            var (success, message) = await ViewModel.PlaceOrderAsync(_selectedRow, _orderQuantity);
            _orderMessage = message;
            if (success)
                CloseOrderModal();
        }
        finally
        {
            _isPlacingOrder = false;
        }
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private static string GetPredictionLabel(SentimentPrediction prediction) => prediction switch
    {
        SentimentPrediction.Bullish => "Bullish",
        SentimentPrediction.Bearish => "Bearish",
        _ => "Neutral"
    };

    private static string GetPredictionClass(SentimentPrediction prediction) => prediction switch
    {
        SentimentPrediction.Bullish => "buy",
        SentimentPrediction.Bearish => "sell",
        _ => "neutral"
    };

    private static string GetLabelClass(string label) => label.ToLowerInvariant() switch
    {
        "positive" => "buy",
        "negative" => "sell",
        _ => "neutral"
    };

    private static string GetHeadlineIcon(string label) => label.ToLowerInvariant() switch
    {
        "positive" => "🟢",
        "negative" => "🔴",
        _ => "🟡"
    };

    private IEnumerable<NewsSentimentItem> GetTopHeadlines() =>
        ViewModel.Results
            .SelectMany(r => r.Headlines)
            .Take(8);

    public void Dispose() => ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}
