@page "/"
@using PGOne.Services
@inject DashboardViewModel ViewModel
@inject SentimentViewModel SentimentViewModel
@implements IDisposable

<div class="dashboard">
    <div class="dashboard-top">
        <div class="watchlist-panel card">
            <div class="watchlist-section">
                <div class="watchlist-section-title">Indices</div>
                <div class="watchlist-items">
                    @foreach (var item in ViewModel.IndexWatchlist)
                    {
                        <div class="watchlist-row favorite @(ViewModel.SelectedSymbol == item.Symbol ? "selected" : "")"
                             @onclick="() => SelectSymbol(item.Symbol)">
                            <div class="watchlist-row-main">
                                <span class="symbol">@InstrumentMapper.ToIndexShortName(item.Symbol)</span>
                                <span class="bs-badge @TrendUi.GetClass(item.Trend)">@TrendUi.GetBadgeLabel(item.Trend)</span>
                            </div>
                            <div class="watchlist-row-meta">
                                <span class="index-change @(item.ChangePercent >= 0 ? "positive" : "negative")">
                                    @(item.ChangePercent >= 0 ? "+" : "")@item.ChangePercent.ToString("N2")%
                                </span>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="watchlist-section">
                <div class="watchlist-section-title">Top 10 Weight</div>
                <div class="watchlist-items">
                    @foreach (var item in ViewModel.Top10Watchlist)
                    {
                        <div class="watchlist-row @(ViewModel.SelectedSymbol == item.Symbol ? "selected" : "")"
                             @onclick="() => SelectSymbol(item.Symbol)">
                            <div class="watchlist-row-main">
                                <span class="symbol">@item.Symbol</span>
                                <span class="bs-badge @TrendUi.GetClass(item.Trend)">@TrendUi.GetBadgeLabel(item.Trend)</span>
                            </div>
                            <div class="watchlist-row-meta">
                                <span class="index-change @(item.ChangePercent >= 0 ? "positive" : "negative")">
                                    @(item.ChangePercent >= 0 ? "+" : "")@item.ChangePercent.ToString("N2")%
                                </span>
                                @if (item.Weight > 0)
                                {
                                    <span class="weight-label">@item.Weight.ToString("N1")%</span>
                                }
                                <span class="sparkline @(item.ChangePercent >= 0 ? "up" : item.ChangePercent < 0 ? "down" : "")">@item.Sparkline</span>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="chart-panel card">
            <div class="chart-header">
                <div class="instrument-info">
                    <div class="instrument-title-row">
                        <h2>@ViewModel.SelectedDisplayName</h2>
                        <span class="market-status @(ViewModel.IsMarketOpen ? "open" : "closed")">
                            @ViewModel.MarketStatus
                        </span>
                    </div>
                    <div class="price-row">
                        <span class="price">@ViewModel.NiftyPrice.ToString("N2")</span>
                        <span class="change @(ViewModel.NiftyChange >= 0 ? "positive" : "negative")">
                            @(ViewModel.NiftyChange >= 0 ? "▲" : "▼") @Math.Abs(ViewModel.NiftyChange).ToString("N2") (@ViewModel.NiftyChangePercent%)
                        </span>
                        <TrendBadge Trend="ViewModel.NiftyTrend" />
                    </div>
                </div>
            </div>
            <CandlestickChart CanvasId="priceChart"
                              Candles="ViewModel.ChartCandles"
                              ChartVersion="ViewModel.ChartVersion"
                              Timeframe="ViewModel.SelectedTimeframe"
                              Width="900"
                              Height="420" />
            <div class="timeframe-buttons">
                @foreach (var tf in new[] { "5m", "15m", "1H" })
                {
                    <button class="btn tf-btn @(ViewModel.SelectedTimeframe == tf ? "active" : "")"
                            @onclick="() => ChangeTimeframe(tf)">@tf</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(ViewModel.ChartDataMessage))
            {
                <div class="chart-meta @(ViewModel.IsChartFromZerodha ? "zerodha" : "warning")">
                    @ViewModel.ChartDataMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(ViewModel.LastCandleSummary))
            {
                <div class="chart-meta">Last bar: @ViewModel.LastCandleSummary</div>
            }
        </div>

        <AiInsightPanel Analysis="ViewModel.Analysis"
                        SuggestedAction="@AiInsightHelper.GetSuggestedAction(ViewModel.CurrentSignal, ViewModel.Analysis)" />
    </div>

    <div class="dashboard-bottom">
        <div class="analysis-panel card">
            <div class="card-header">Multi Timeframe Analysis</div>
            <table class="analysis-table">
                <tr>
                    <td>Probability</td>
                    <td class="@GetOverallScoreClass(ViewModel.Analysis)">
                        @ViewModel.Analysis.OverallScore% — @ViewModel.Analysis.Strength
                    </td>
                </tr>
                <tr>
                    <td>1H Bias — RSI(28) @ViewModel.Analysis.RsiTrend</td>
                    <td class="@TrendUi.GetClass(ViewModel.Analysis.RsiBias)">@TrendUi.GetIcon(ViewModel.Analysis.RsiBias) @TrendUi.GetBiasLabel(ViewModel.Analysis.RsiBias)</td>
                </tr>
                <tr>
                    <td>1 Hour SuperTrend</td>
                    <td class="@TrendUi.GetClass(ViewModel.Analysis.Trend1H)">@TrendUi.GetIcon(ViewModel.Analysis.Trend1H) @ViewModel.Analysis.Trend1H</td>
                </tr>
                <tr>
                    <td>15 Min SuperTrend</td>
                    <td class="@TrendUi.GetClass(ViewModel.Analysis.Trend15M)">@TrendUi.GetIcon(ViewModel.Analysis.Trend15M) @ViewModel.Analysis.Trend15M</td>
                </tr>
                <tr>
                    <td>5 Min SuperTrend</td>
                    <td class="@TrendUi.GetClass(ViewModel.Analysis.Trend5M)">@TrendUi.GetIcon(ViewModel.Analysis.Trend5M) @ViewModel.Analysis.Trend5M</td>
                </tr>
                <tr>
                    <td>ADX(14) 1H</td>
                    <td>@ViewModel.Analysis.Adx — @ViewModel.Analysis.Strength1H</td>
                </tr>
                <tr>
                    <td>5m VWAP @ViewModel.Analysis.Vwap5M.ToString("N2")</td>
                    <td class="@(ViewModel.Analysis.AboveVwap ? "buy" : "sell")">@(ViewModel.Analysis.AboveVwap ? "Above (Bullish)" : "Below (Bearish)")</td>
                </tr>
                <tr>
                    <td>Regime</td>
                    <td>@(ViewModel.Analysis.IsRangebound ? "Range-bound → Keltner" : "Trending")</td>
                </tr>
                <tr>
                    <td>CPR</td>
                    <td>@ViewModel.Analysis.Cpr</td>
                </tr>
            </table>
        </div>

        <div class="signal-panel card">
            <div class="card-header">Current Signal</div>
            @if (ViewModel.Analysis.WaitForReversal)
            {
                <div class="signal-check sell">⚠ Reversal risk: @ViewModel.Analysis.ReversalReason</div>
            }
            <div class="signal-checks">
                <div class="signal-check">Bias : @TrendUi.GetBiasLabel(ViewModel.Analysis.RsiBias) (RSI28 @ViewModel.Analysis.RsiTrend)</div>
                <div class="signal-check">Strength : @ViewModel.Analysis.Strength1H (ADX @ViewModel.Analysis.Adx)</div>
                <div class="signal-check">5m VWAP : @(ViewModel.Analysis.AboveVwap ? "Bullish" : "Bearish")</div>
                <div class="signal-check">Entry : @ViewModel.CurrentSignal.Entry</div>
                <div class="signal-check">Plan : @ViewModel.CurrentSignal.Strategy</div>
                <div class="signal-check">Confidence : @ViewModel.CurrentSignal.Confidence%</div>
            </div>
        </div>

        <div class="news-panel card">
            <div class="card-header">
                <span>News</span>
                <a class="news-link" href="sentiment">View all →</a>
            </div>
            <div class="news-list">
                @foreach (var headline in GetNewsHeadlines())
                {
                    <div class="news-item">
                        @headline.Icon @headline.Text
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="dashboard-positions">
        <div class="card">
            <div class="card-header">
                <h2>Positions</h2>
                <button class="btn btn-secondary btn-sm" @onclick="RefreshPositionsAsync"
                        disabled="@ViewModel.IsPositionsLoading">
                    Refresh
                </button>
            </div>

            @if (!ViewModel.IsConnected)
            {
                <div class="holdings-banner warning">Connect to Zerodha in Settings to view live positions.</div>
            }
            else if (ViewModel.IsPositionsLoading && ViewModel.Positions.Count == 0)
            {
                <div class="scanning">Loading positions...</div>
            }
            else if (ViewModel.Positions.Count == 0)
            {
                <div class="empty-state">No open positions.</div>
            }
            else
            {
                @if (ViewModel.IsPositionsLoading)
                {
                    <div class="status-message">Refreshing positions...</div>
                }
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Symbol</th>
                            <th>Qty</th>
                            <th>Avg Price</th>
                            <th>LTP</th>
                            <th>P&amp;L</th>
                            <th>Side</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var pos in ViewModel.Positions)
                        {
                            <tr>
                                <td><strong>@pos.Symbol</strong></td>
                                <td>@pos.Quantity</td>
                                <td>@pos.AveragePrice.ToString("N2")</td>
                                <td>@pos.LastPrice.ToString("N2")</td>
                                <td class="@(pos.PnL >= 0 ? "buy" : "sell")">@pos.PnL.ToString("N2")</td>
                                <td class="@GetTrendClass(pos.Side)">@pos.Side</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        <div class="card">
            <div class="card-header">
                <h2>Intraday trailing stop loss</h2>
                <button class="btn btn-secondary btn-sm" @onclick="RefreshTrailingStopAsync"
                        disabled="@ViewModel.IsTrailingStopLoading">
                    Refresh
                </button>
            </div>

            <p class="text-secondary">
                Open MIS positions — ST(7, 2.5) on 5m. Auto square-off when candle closes through SuperTrend.
            </p>

            <div class="framework-panel">
                <div class="framework-panel-title">Trailing Stop — ST(7, 2.5) on 5m</div>
                <ul class="framework-conditions">
                    <li>Long (buy): exit when 5m candle <strong>closes below</strong> ST(7, 2.5)</li>
                    <li>Short (sell): exit when 5m candle <strong>closes above</strong> ST(7, 2.5)</li>
                    <li>Uses last completed 5m candle (not the live forming bar)</li>
                    <li>Enable auto-exit to place LIMIT square-off orders on breach</li>
                </ul>
                <div class="trailing-stop-controls">
                    <label class="checkbox-label">
                        <input type="checkbox" checked="@ViewModel.IsTrailingStopMonitoring"
                               @onchange="OnTrailingStopMonitoringChanged" />
                        Auto-exit on ST breach
                    </label>
                    @if (!string.IsNullOrEmpty(ViewModel.TrailingStopStatusMessage))
                    {
                        <span class="trailing-stop-status">@ViewModel.TrailingStopStatusMessage</span>
                    }
                </div>
            </div>

            @if (!ViewModel.IsConnected)
            {
                <div class="holdings-banner warning">Connect to Zerodha in Settings for MIS trailing stop.</div>
            }
            else if (ViewModel.IsTrailingStopLoading && ViewModel.TrailingStopItems.Count == 0)
            {
                <div class="scanning">Loading open MIS positions...</div>
            }
            else if (ViewModel.TrailingStopItems.Count == 0)
            {
                <div class="empty-state">No open MIS positions to trail.</div>
            }
            else
            {
                @if (ViewModel.IsTrailingStopLoading)
                {
                    <div class="status-message">Refreshing trailing stop data...</div>
                }
                <div class="holdings-summary">
                    <span class="summary-pill">@ViewModel.TrailingStopMonitoringCount open</span>
                    @if (ViewModel.TrailingStopTriggeredCount > 0)
                    {
                        <span class="summary-pill sell">@ViewModel.TrailingStopTriggeredCount exit signal</span>
                    }
                    @if (ViewModel.IsTrailingStopMonitoring)
                    {
                        <span class="summary-pill buy">Auto-exit on</span>
                    }
                </div>

                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Stock</th>
                            <th>Exch</th>
                            <th>Side</th>
                            <th>Qty</th>
                            <th>LTP</th>
                            <th>ST (7, 2.5)</th>
                            <th>Last 5m close</th>
                            <th>P&amp;L</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ViewModel.TrailingStopItems)
                        {
                            <tr class="@GetTrailingRowClass(item)">
                                <td><strong>@item.Symbol</strong></td>
                                <td><span class="exchange-badge">@item.Exchange</span></td>
                                <td class="@(item.Side == TrendDirection.Buy ? "buy" : "sell")">@item.Side</td>
                                <td>@item.Quantity</td>
                                <td>@item.LastPrice.ToString("N2")</td>
                                <td>@item.SuperTrendLevel.ToString("N2")</td>
                                <td>@item.LastClosedPrice.ToString("N2")</td>
                                <td class="@(item.PnL >= 0 ? "buy" : "sell")">@item.PnL.ToString("N2")</td>
                                <td>
                                    <span class="framework-badge @GetTrailingStatusClass(item)">@item.Status</span>
                                    @if (!string.IsNullOrEmpty(item.Detail))
                                    {
                                        <div class="trailing-detail">@item.Detail</div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>

@code {
  private System.Timers.Timer? _refreshTimer;

  private readonly List<NewsHeadline> _fallbackHeadlines =
  [
      new("🟢", "Reliance jumps after earnings"),
      new("🔴", "US Futures fall"),
      new("🟢", "RBI keeps rates unchanged"),
      new("🟡", "Infosys announces buyback plan")
  ];

  protected override async Task OnInitializedAsync()
  {
    await ViewModel.InitializeAsync();
    ViewModel.PropertyChanged += OnViewModelPropertyChanged;
    SentimentViewModel.PropertyChanged += OnSentimentPropertyChanged;

    _refreshTimer = new System.Timers.Timer(30000);
    _refreshTimer.Elapsed += (_, _) => _ = InvokeAsync(async () => await ViewModel.RefreshAsync());
    _refreshTimer.Start();
  }

  private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e) =>
    InvokeAsync(StateHasChanged);

  private void OnSentimentPropertyChanged(object? sender, PropertyChangedEventArgs e) =>
    InvokeAsync(StateHasChanged);

  private IEnumerable<NewsHeadline> GetNewsHeadlines()
  {
    var live = SentimentViewModel.Results
        .SelectMany(r => r.Headlines)
        .Take(4)
        .Select(h => new NewsHeadline(GetHeadlineIcon(h.Label), h.Headline))
        .ToList();

    return live.Count > 0 ? live : _fallbackHeadlines;
  }

  private static string GetHeadlineIcon(string label) => label.ToLowerInvariant() switch
  {
      "positive" => "🟢",
      "negative" => "🔴",
      _ => "🟡"
  };

  private async Task ChangeTimeframe(string timeframe)
  {
    await ViewModel.ChangeTimeframeAsync(timeframe);
  }

  private async Task RefreshPositionsAsync()
  {
    await ViewModel.RefreshPositionsAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task RefreshTrailingStopAsync()
  {
    await ViewModel.RefreshTrailingStopAsync();
    await InvokeAsync(StateHasChanged);
  }

  private async Task OnTrailingStopMonitoringChanged(ChangeEventArgs e)
  {
    var enabled = e.Value is true;
    await ViewModel.SetTrailingStopMonitoringAsync(enabled);
  }

  private async Task SelectSymbol(string symbol)
  {
    await ViewModel.SelectInstrumentAsync(symbol);
  }

  private static string GetTrendClass(TrendDirection trend) => TrendUi.GetClass(trend);

  private static string GetOverallScoreClass(MultiTimeframeAnalysis analysis) => analysis.Strength1H switch
  {
      TrendStrength.Strong => "buy",
      TrendStrength.Moderate => "neutral",
      _ => "sell"
  };

  private static string GetTrailingRowClass(TrailingStopRow item) => item.ExitPlaced
      ? "closed-row"
      : item.IsTriggered ? "review-row" : "aligned-row";

  private static string GetTrailingStatusClass(TrailingStopRow item) => item.ExitPlaced
      ? "neutral"
      : item.IsTriggered ? "sell" : "buy";

  private sealed record NewsHeadline(string Icon, string Text);

  public void Dispose()
  {
    _refreshTimer?.Dispose();
    ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
    SentimentViewModel.PropertyChanged -= OnSentimentPropertyChanged;
  }
}
