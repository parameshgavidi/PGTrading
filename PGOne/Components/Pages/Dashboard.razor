@page "/"
@inject DashboardViewModel ViewModel
@implements IDisposable

<div class="dashboard">
    <div class="dashboard-top">
        <div class="watchlist-panel card">
            <div class="card-header">Watchlist</div>
            <div class="watchlist-items">
                @foreach (var item in ViewModel.Watchlist)
                {
                    <div class="watchlist-row @(item.IsFavorite ? "favorite" : "")">
                        <span class="symbol">@(item.IsFavorite ? "★ " : "")@item.Symbol</span>
                        <span class="trend @GetTrendClass(item.Trend)">@item.Trend</span>
                    </div>
                }
            </div>
        </div>

        <div class="chart-panel card">
            <div class="chart-header">
                <div class="instrument-info">
                    <div class="instrument-title-row">
                        <h2>NIFTY 50</h2>
                        <span class="market-status @(ViewModel.IsMarketOpen ? "open" : "closed")">
                            @ViewModel.MarketStatus
                        </span>
                    </div>
                    <div class="price-row">
                        <span class="price">@ViewModel.NiftyPrice.ToString("N2")</span>
                        <span class="change @(ViewModel.NiftyChange >= 0 ? "positive" : "negative")">
                            @(ViewModel.NiftyChange >= 0 ? "▲" : "▼") @Math.Abs(ViewModel.NiftyChange).ToString("N2") (@ViewModel.NiftyChangePercent%)
                        </span>
                        <span class="trend-badge @GetTrendClass(ViewModel.NiftyTrend)">Trend: @ViewModel.NiftyTrend</span>
                    </div>
                </div>
            </div>
            <CandlestickChart CanvasId="priceChart"
                              Candles="ViewModel.ChartCandles"
                              ChartVersion="ViewModel.ChartVersion"
                              Timeframe="ViewModel.SelectedTimeframe"
                              Width="800"
                              Height="350" />
            <div class="timeframe-buttons">
                @foreach (var tf in new[] { "5m", "15m", "1H" })
                {
                    <button class="btn tf-btn @(ViewModel.SelectedTimeframe == tf ? "active" : "")"
                            @onclick="() => ChangeTimeframe(tf)">@tf</button>
                }
            </div>
            @if (!string.IsNullOrEmpty(ViewModel.ChartDataMessage))
            {
                <div class="chart-meta @(ViewModel.IsChartFromZerodha ? "zerodha" : "warning")">
                    @ViewModel.ChartDataMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(ViewModel.LastCandleSummary))
            {
                <div class="chart-meta">Last bar: @ViewModel.LastCandleSummary</div>
            }
        </div>
    </div>

    <div class="dashboard-bottom">
        <div class="analysis-panel card">
            <div class="card-header">Multi Timeframe Analysis</div>
            <table class="analysis-table">
                <tr>
                    <td>1H Bias — RSI(28) @ViewModel.Analysis.RsiTrend</td>
                    <td class="@GetTrendClass(ViewModel.Analysis.RsiBias)">@GetTrendIcon(ViewModel.Analysis.RsiBias) @BiasLabel(ViewModel.Analysis.RsiBias)</td>
                </tr>
                <tr>
                    <td>1 Hour SuperTrend</td>
                    <td class="@GetTrendClass(ViewModel.Analysis.Trend1H)">@GetTrendIcon(ViewModel.Analysis.Trend1H) @ViewModel.Analysis.Trend1H</td>
                </tr>
                <tr>
                    <td>15 Min SuperTrend</td>
                    <td class="@GetTrendClass(ViewModel.Analysis.Trend15M)">@GetTrendIcon(ViewModel.Analysis.Trend15M) @ViewModel.Analysis.Trend15M</td>
                </tr>
                <tr>
                    <td>5 Min SuperTrend</td>
                    <td class="@GetTrendClass(ViewModel.Analysis.Trend5M)">@GetTrendIcon(ViewModel.Analysis.Trend5M) @ViewModel.Analysis.Trend5M</td>
                </tr>
                <tr>
                    <td>ADX(14) 1H</td>
                    <td>@ViewModel.Analysis.Adx — @ViewModel.Analysis.Strength1H</td>
                </tr>
                <tr>
                    <td>5m VWAP @ViewModel.Analysis.Vwap5M.ToString("N2")</td>
                    <td class="@(ViewModel.Analysis.AboveVwap ? "buy" : "sell")">@(ViewModel.Analysis.AboveVwap ? "Above (Bullish)" : "Below (Bearish)")</td>
                </tr>
                <tr>
                    <td>Regime</td>
                    <td>@(ViewModel.Analysis.IsRangebound ? "Range-bound → Keltner" : "Trending")</td>
                </tr>
                <tr>
                    <td>CPR</td>
                    <td>@ViewModel.Analysis.Cpr</td>
                </tr>
            </table>
        </div>

        <div class="score-panel card">
            <div class="card-header">Overall Score</div>
            <div class="score-value">@ViewModel.Analysis.OverallScore%</div>
            <div class="score-strength">@ViewModel.Analysis.Strength</div>
        </div>

        <div class="signal-panel card">
            <div class="card-header">Current Signal</div>
            @if (ViewModel.Analysis.WaitForReversal)
            {
                <div class="signal-check sell">⚠ Reversal risk: @ViewModel.Analysis.ReversalReason</div>
            }
            <div class="signal-checks">
                <div class="signal-check">Bias : @BiasLabel(ViewModel.Analysis.RsiBias) (RSI28 @ViewModel.Analysis.RsiTrend)</div>
                <div class="signal-check">Strength : @ViewModel.Analysis.Strength1H (ADX @ViewModel.Analysis.Adx)</div>
                <div class="signal-check">5m VWAP : @(ViewModel.Analysis.AboveVwap ? "Bullish" : "Bearish")</div>
                <div class="signal-check">Entry : @ViewModel.CurrentSignal.Entry</div>
                <div class="signal-check">Plan : @ViewModel.CurrentSignal.Strategy</div>
                <div class="signal-check">Confidence : @ViewModel.CurrentSignal.Confidence%</div>
            </div>
        </div>
    </div>
</div>

@code {
  private System.Timers.Timer? _refreshTimer;

  protected override async Task OnInitializedAsync()
  {
    await ViewModel.InitializeAsync();
    ViewModel.PropertyChanged += OnViewModelPropertyChanged;

    _refreshTimer = new System.Timers.Timer(30000);
    _refreshTimer.Elapsed += async (_, _) => await ViewModel.RefreshAsync();
    _refreshTimer.Start();
  }

  private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
  {
    InvokeAsync(StateHasChanged);
  }

  private async Task ChangeTimeframe(string timeframe)
  {
    await ViewModel.ChangeTimeframeAsync(timeframe);
  }

  private static string GetTrendClass(TrendDirection trend) => trend switch
  {
    TrendDirection.Buy => "buy",
    TrendDirection.Sell => "sell",
    _ => "neutral"
  };

  private static string GetTrendIcon(TrendDirection trend) => trend switch
  {
    TrendDirection.Buy => "🟢",
    TrendDirection.Sell => "🔴",
    _ => "⚪"
  };

  private static string BiasLabel(TrendDirection bias) => bias switch
  {
    TrendDirection.Buy => "Bullish",
    TrendDirection.Sell => "Bearish",
    _ => "Neutral"
  };

  public void Dispose()
  {
    _refreshTimer?.Dispose();
    ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
  }
}
