@page "/holdings"
@inject HoldingsViewModel ViewModel
@implements IDisposable

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <h2>Holdings</h2>
            <button class="btn btn-secondary" @onclick="RefreshAsync" disabled="@ViewModel.IsLoading">Refresh</button>
        </div>

        <p class="text-secondary">
            @if (_activeTab == HoldingsTab.Intraday)
            {
                <text>MIS (intraday) positions for today — open and closed (squared-off). Open positions are evaluated against the intraday trade framework.</text>
            }
            else
            {
                <text>Delivery (CNC) holdings evaluated against the long-term Chartink framework.</text>
            }
            Stocks marked <span class="buy">Up</span> satisfy the active framework; others show a stop-loss level to review.
        </p>

        @if (!ViewModel.IsConnected)
        {
            <div class="holdings-banner warning">
                Showing demo holdings on the Long term tab. Connect to Zerodha in Settings for live portfolio data.
            </div>
        }
        else if (!string.IsNullOrEmpty(ViewModel.ErrorMessage))
        {
            <div class="holdings-banner warning">
                @ViewModel.ErrorMessage
            </div>
        }

        <div class="holdings-tabs">
            <button class="holdings-tab @(_activeTab == HoldingsTab.Intraday ? "active" : "")"
                    @onclick="() => SelectTab(HoldingsTab.Intraday)">
                Intraday (MIS)
            </button>
            <button class="holdings-tab @(_activeTab == HoldingsTab.LongTerm ? "active" : "")"
                    @onclick="() => SelectTab(HoldingsTab.LongTerm)">
                Long term (CNC)
            </button>
        </div>

        <div class="framework-panel">
            <div class="framework-panel-title">
                @(_activeTab == HoldingsTab.Intraday ? "Intraday Framework Conditions" : "Long term Framework Conditions (Chartink)")
            </div>
            <ul class="framework-conditions">
                @foreach (var condition in ActiveFrameworkConditions)
                {
                    <li>@condition</li>
                }
            </ul>
        </div>

        @if (ViewModel.IsLoading)
        {
            <div class="scanning">Analyzing holdings against @(_activeTab == HoldingsTab.Intraday ? "intraday" : "long-term") framework...</div>
        }
        else if (ActiveItems.Count == 0)
        {
            <div class="empty-state">
                @if (_activeTab == HoldingsTab.Intraday)
                {
                    <text>No MIS positions today. Intraday tab shows open and closed MIS positions from your Zerodha account.</text>
                }
                else
                {
                    <text>No delivery holdings found.</text>
                }
            </div>
        }
        else
        {
            <div class="holdings-summary">
                <span class="summary-pill">@ActiveItems.Count total</span>
                @if (_activeTab == HoldingsTab.Intraday)
                {
                    <span class="summary-pill">@ViewModel.IntradayOpenCount open</span>
                    <span class="summary-pill">@ViewModel.IntradayClosedCount closed</span>
                }
                <span class="summary-pill buy">@ActiveSatisfiedCount Up</span>
                <span class="summary-pill sell">@ActiveReviewCount Need review</span>
            </div>

            <table class="data-table">
                <thead>
                    <tr>
                        <th>Stock</th>
                        <th>Exch</th>
                        <th>Qty</th>
                        <th>Avg</th>
                        <th>LTP</th>
                        <th>Today %</th>
                        <th>Overall %</th>
                        <th>Framework</th>
                        <th>@(_activeTab == HoldingsTab.Intraday ? "P&L / Stop Loss" : "Stop Loss")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ActiveItems)
                    {
                        <tr class="@GetRowClass(item)">
                            <td><strong>@item.Symbol</strong></td>
                            <td><span class="exchange-badge">@item.Exchange</span></td>
                            <td>@(item.IsClosed ? "Sq off" : item.Quantity.ToString())</td>
                            <td>@item.AveragePrice.ToString("N2")</td>
                            <td>@item.LastPrice.ToString("N2")</td>
                            <td class="@(item.DayChangePercent >= 0 ? "buy" : "sell")">
                                @(item.IsClosed ? "—" : $"{(item.DayChangePercent >= 0 ? "+" : "")}{item.DayChangePercent:N2}%")
                            </td>
                            <td class="@(item.OverallChangePercent >= 0 ? "buy" : "sell")">
                                @(item.IsClosed ? "—" : $"{(item.OverallChangePercent >= 0 ? "+" : "")}{item.OverallChangePercent:N2}%")
                            </td>
                            <td>
                                <span class="framework-badge @GetFrameworkClass(item)">
                                    @item.FrameworkStatus
                                </span>
                                @if (!item.IsClosed)
                                {
                                    <span class="score-badge">@item.FrameworkScore%</span>
                                }
                            </td>
                            <td class="@GetStopLossClass(item)">
                                @(item.IsClosed
                                    ? $"{(item.PnL >= 0 ? "+" : "")}{item.PnL:N2}"
                                    : item.StopLossRecommendation ?? "—")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
  private enum HoldingsTab { Intraday, LongTerm }

  private HoldingsTab _activeTab = HoldingsTab.Intraday;

  private IReadOnlyList<HoldingRow> ActiveItems =>
    _activeTab == HoldingsTab.Intraday ? ViewModel.IntradayItems : ViewModel.LongTermItems;

  private IReadOnlyList<string> ActiveFrameworkConditions =>
    _activeTab == HoldingsTab.Intraday
      ? ViewModel.IntradayFrameworkConditions
      : ViewModel.LongTermFrameworkConditions;

  private int ActiveSatisfiedCount =>
    _activeTab == HoldingsTab.Intraday
      ? ViewModel.IntradaySatisfiedCount
      : ViewModel.LongTermSatisfiedCount;

  private int ActiveReviewCount =>
    _activeTab == HoldingsTab.Intraday
      ? ViewModel.IntradayReviewCount
      : ViewModel.LongTermReviewCount;

  protected override async Task OnInitializedAsync()
  {
    ViewModel.PropertyChanged += OnViewModelPropertyChanged;
    await RefreshAsync();
  }

  private void SelectTab(HoldingsTab tab)
  {
    _activeTab = tab;
    StateHasChanged();
  }

  private async Task RefreshAsync() => await ViewModel.RefreshAsync();

  private static string GetRowClass(HoldingRow item) => item.IsClosed
      ? "closed-row"
      : item.FrameworkSatisfied ? "aligned-row" : "review-row";

  private static string GetFrameworkClass(HoldingRow item) => item.IsClosed
      ? "neutral"
      : item.FrameworkSatisfied ? "buy" : "sell";

  private static string GetStopLossClass(HoldingRow item) => item.IsClosed
      ? item.PnL >= 0 ? "buy" : "sell"
      : item.FrameworkSatisfied ? "neutral" : "sell";

  private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    => InvokeAsync(StateHasChanged);

  public void Dispose() => ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}
