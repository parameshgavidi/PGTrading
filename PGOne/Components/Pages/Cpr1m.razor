@page "/cpr-1m"
@inject DashboardViewModel ViewModel
@implements IDisposable

<div class="page-container">
    <div class="card chart-full cpr-1m-panel">
        <div class="chart-header">
            <div class="instrument-title-row">
                <h2 class="page-heading">@ViewModel.SelectedDisplayName · 1m CPR</h2>
                <span class="market-status @(ViewModel.IsMarketOpen ? "open" : "closed")">
                    @ViewModel.MarketStatus
                </span>
            </div>
            <div class="price-row">
                <span class="price">@ViewModel.NiftyPrice.ToString("N2")</span>
                <span class="change @(ViewModel.NiftyChange >= 0 ? "positive" : "negative")">
                    @(ViewModel.NiftyChange >= 0 ? "▲" : "▼") @Math.Abs(ViewModel.NiftyChange).ToString("N2") (@ViewModel.NiftyChangePercent%)
                </span>
                <TrendBadge Trend="ViewModel.NiftyTrend" />
                @if (ViewModel.SupportsIntradayCprOverlay && ViewModel.ShowIntradayCprOverlay)
                {
                    <span class="cpr-position-badge @ViewModel.CprPositionClass">@ViewModel.CprPositionLabel</span>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewModel.StartupError))
        {
            <div class="chart-meta warning">Startup: @ViewModel.StartupError</div>
        }
        @if (!ViewModel.IsDashboardReady)
        {
            <div class="chart-meta">Loading market data…</div>
        }

        <Cpr1mChart CanvasId="cpr1mChart"
                      Candles="ViewModel.ChartCandles"
                      Segments="ViewModel.CprSegments"
                      ChartVersion="ViewModel.ChartVersion"
                      OverlayVersion="ViewModel.OverlayVersion"
                      ShowKeltnerLevels="ViewModel.ShowKeltnerOverlay"
                      CssClass="large"
                      Width="1200"
                      Height="520" />

        @if (ViewModel.ShowIntradayCprOverlay && ViewModel.SupportsIntradayCprOverlay)
        {
            <CprSegmentsStrip Segments="ViewModel.CprSegments"
                              ActiveSegment="ViewModel.ActiveCprSegment" />
        }

        <div class="chart-toolbar">
            <div class="timeframe-buttons">
                @foreach (var tf in new[] { "1m", "5m", "15m", "1H" })
                {
                    <button type="button"
                            class="btn tf-btn @(ViewModel.SelectedTimeframe == tf ? "active" : "")"
                            @onclick="() => ViewModel.ChangeTimeframeAsync(tf)">@tf</button>
                }
            </div>
            <ChartOverlayToggles ShowIntradayCprToggle="ViewModel.SupportsIntradayCprOverlay"
                                 ShowKeltnerToggle="@(ViewModel.SelectedTimeframe == "1m" || ViewModel.SelectedTimeframe == "5m")"
                                 Show5mStudyToggles="ViewModel.Supports5mStudyToggles"
                                 ShowPoc="ViewModel.ShowPocOverlay"
                                 ShowDayCpr="ViewModel.ShowPivotOverlay"
                                 ShowCamarilla="ViewModel.ShowCamarillaOverlay"
                                 ShowIntradayCpr="ViewModel.ShowIntradayCprOverlay"
                                 ShowKeltner="ViewModel.ShowKeltnerOverlay"
                                 ShowSuperTrend="ViewModel.ShowSuperTrendOverlay"
                                 ShowEma20="ViewModel.ShowEma20Overlay"
                                 ShowVwap="ViewModel.ShowVwapOverlay"
                                 ShowPocChanged="v => ViewModel.SetShowPocOverlay(v)"
                                 ShowDayCprChanged="v => ViewModel.SetShowPivotOverlay(v)"
                                 ShowCamarillaChanged="v => ViewModel.SetShowCamarillaOverlay(v)"
                                 ShowIntradayCprChanged="v => ViewModel.SetShowIntradayCprOverlay(v)"
                                 ShowKeltnerChanged="v => ViewModel.SetShowKeltnerOverlay(v)"
                                 ShowSuperTrendChanged="v => ViewModel.SetShowSuperTrendOverlay(v)"
                                 ShowEma20Changed="v => ViewModel.SetShowEma20Overlay(v)"
                                 ShowVwapChanged="v => ViewModel.SetShowVwapOverlay(v)" />
        </div>

        @if (!string.IsNullOrEmpty(ViewModel.ChartDataMessage))
        {
            <div class="chart-meta @(ViewModel.IsChartFromZerodha ? "zerodha" : "warning")">
                @ViewModel.ChartDataMessage
            </div>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        await ViewModel.Ensure1mCprPageAsync();
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}
