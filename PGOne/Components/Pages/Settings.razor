@page "/settings"
@inject SettingsViewModel ViewModel
@inject IJSRuntime JS
@implements IDisposable

<div class="page-container">
    <div class="card settings-card">
        <div class="card-header">
            <h2>Settings</h2>
            <span class="connection-badge @(ViewModel.IsConnected ? "connected" : "disconnected")">
                <span class="status-dot"></span>
                @(ViewModel.IsConnected ? "Connected to Zerodha" : "Not connected")
            </span>
        </div>

        <div class="settings-section">
            <h3>Broker — Zerodha</h3>
            <div class="form-row">
                <label>Broker</label>
                <input type="text" value="Zerodha" class="form-input" disabled />
            </div>
            <div class="form-row">
                <label>API Key</label>
                <input type="text" @bind="ViewModel.Settings.ApiKey" @bind:event="oninput" class="form-input" placeholder="Your Kite Connect API Key" />
            </div>
            <div class="form-row">
                <label>API Secret</label>
                <input type="password" @bind="ViewModel.Settings.ApiSecret" @bind:event="oninput" class="form-input" placeholder="Your Kite Connect API Secret" />
            </div>

            <div class="zerodha-connect">
                <h4>Connect to Zerodha</h4>
                <p class="text-secondary">
                    1. Click <strong>Save Settings</strong> after entering API Key and Secret.<br />
                    2. Click <strong>Open Zerodha Login</strong> and authorize the app.<br />
                    3. Copy only the <code>request_token</code> value from the redirect URL.<br />
                    4. Paste it below and click <strong>Connect</strong>.
                </p>
                <button class="btn btn-secondary" @onclick="OpenLogin">Open Zerodha Login</button>
                <div class="form-row">
                    <label>Request Token</label>
                    <input type="text" @bind="ViewModel.RequestToken" @bind:event="oninput" class="form-input" placeholder="Paste request_token here" />
                </div>
                <div class="button-row">
                    <button class="btn btn-primary" disabled="@ViewModel.IsConnecting" @onclick="Connect">
                        @(ViewModel.IsConnecting ? "Connecting…" : "Connect")
                    </button>
                    @if (ViewModel.IsConnected)
                    {
                        <button class="btn btn-danger" @onclick="Disconnect">Disconnect</button>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_connectStatusMessage))
                {
                    <div class="status-message @(_connectStatusIsSuccess ? "success" : "error")">
                        @_connectStatusMessage
                    </div>
                }
            </div>
        </div>

        <div class="settings-section">
            <h3>Trading</h3>
            <div class="form-row">
                <label>Lot Size</label>
                <input type="number" @bind="ViewModel.Settings.LotSize" class="form-input" />
            </div>
            <div class="form-row">
                <label>Risk %</label>
                <input type="number" step="0.1" @bind="ViewModel.Settings.RiskPercent" class="form-input" />
            </div>
            <div class="form-row checkbox-row">
                <label>Auto Trading</label>
                <input type="checkbox"
                       checked="@ViewModel.Settings.AutoTradingEnabled"
                       @onchange="OnAutoTradingChanged" />
                <span class="@(ViewModel.Settings.AutoTradingEnabled ? "buy" : "sell")">
                    @(ViewModel.Settings.AutoTradingEnabled ? "Enabled — live orders allowed" : "Disabled — monitoring only, no broker orders")
                </span>
            </div>
            <p class="text-secondary form-hint">
                Required for Auto Buy and other automation to place orders at Zerodha. Check the box, then click <strong>Save Settings</strong> below.
            </p>
        </div>

        <div class="settings-section">
            <h3>Sentiment Analysis (FinBERT)</h3>
            <p class="text-secondary">
                A free token from <a href="https://huggingface.co/settings/tokens" target="_blank">huggingface.co</a>
                is required for FinBERT. Create a fine-grained token with
                <strong>Make calls to Inference Providers</strong> permission, then paste it below and save.
                Without a token, sentiment scans use a basic keyword fallback.
            </p>
            <div class="form-row">
                <label>Hugging Face API Token</label>
                <input type="password" @bind="ViewModel.Settings.HuggingFaceApiToken" @bind:event="oninput" class="form-input" placeholder="hf_..." />
            </div>
        </div>

        <div class="settings-section">
            <h3>Notifications</h3>
            <div class="form-row checkbox-row">
                <label>Desktop</label>
                <input type="checkbox" @bind="ViewModel.Settings.DesktopNotifications" />
            </div>
            <div class="form-row checkbox-row">
                <label>Telegram</label>
                <input type="checkbox" @bind="ViewModel.Settings.TelegramNotifications" />
            </div>
            @if (ViewModel.Settings.TelegramNotifications)
            {
                <div class="form-row">
                    <label>Bot Token</label>
                    <input type="password" @bind="ViewModel.Settings.TelegramBotToken" class="form-input" />
                </div>
                <div class="form-row">
                    <label>Chat ID</label>
                    <input type="text" @bind="ViewModel.Settings.TelegramChatId" class="form-input" />
                </div>
            }
            <div class="form-row checkbox-row">
                <label>Sound</label>
                <input type="checkbox" @bind="ViewModel.Settings.SoundNotifications" />
            </div>
        </div>

        <button class="btn btn-primary btn-large" @onclick="Save">Save Settings</button>

        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <div class="status-message success">@_statusMessage</div>
        }
    </div>
</div>

@code {
    private string _statusMessage = string.Empty;
    private string _connectStatusMessage = string.Empty;
    private bool _connectStatusIsSuccess;

    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        await ViewModel.LoadAsync();
        _statusMessage = ViewModel.StatusMessage;
    }

    private void OnViewModelPropertyChanged(object? sender, PropertyChangedEventArgs e)
    {
        if (e.PropertyName == nameof(SettingsViewModel.StatusMessage))
        {
            var message = ViewModel.StatusMessage;
            if (message is "Settings saved!" or "Disconnected from Zerodha.")
            {
                _statusMessage = message;
            }
            else
            {
                _connectStatusMessage = message;
                _connectStatusIsSuccess = message.StartsWith("Connected as", StringComparison.Ordinal);
            }

            InvokeAsync(StateHasChanged);
        }
    }

    private async Task Save() => await ViewModel.SaveAsync();

    private void OnAutoTradingChanged(ChangeEventArgs e)
    {
        ViewModel.Settings.AutoTradingEnabled = e.Value is bool enabled && enabled;
        InvokeAsync(StateHasChanged);
    }

    private async Task Connect() => await ViewModel.ConnectAsync();
    private void Disconnect() => ViewModel.Disconnect();

    private async Task OpenLogin()
    {
        if (ViewModel.TryGetLoginUrl(out var url))
            await JS.InvokeVoidAsync("open", url, "_blank");
    }

    public void Dispose() => ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}
