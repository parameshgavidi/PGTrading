@page "/orders"
@inject OrdersViewModel ViewModel
@implements IDisposable

<div class="page-container">
    <div class="card">
        <div class="card-header">
            <h2>Orders</h2>
            <button class="btn btn-secondary" disabled="@ViewModel.IsLoading" @onclick="RefreshAsync">Refresh</button>
        </div>

        @if (!ViewModel.IsConnected)
        {
            <div class="empty-state">
                <p>@ViewModel.OfflineMessage</p>
                <div class="button-row">
                    <a href="settings" class="btn btn-primary">Open Settings</a>
                </div>
            </div>
        }
        else if (ViewModel.Orders.Count == 0)
        {
            <div class="empty-state">No orders today.</div>
        }
        else
        {
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Symbol</th>
                        <th>Type</th>
                        <th>Qty</th>
                        <th>Price</th>
                        <th>Status</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in ViewModel.Orders)
                    {
                        <tr>
                            <td>@order.OrderId</td>
                            <td><strong>@order.Symbol</strong></td>
                            <td class="@(order.TransactionType == OrderSides.Buy ? "buy" : "sell")">@order.TransactionType</td>
                            <td>@order.Quantity</td>
                            <td>@order.Price.ToString("N2")</td>
                            <td><span class="status-badge">@order.Status</span></td>
                            <td>@order.OrderTime.ToString("HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        ViewModel.PropertyChanged += OnViewModelPropertyChanged;
        await ViewModel.RefreshAsync();
    }

    private async Task RefreshAsync() => await ViewModel.RefreshAsync();

    private void OnViewModelPropertyChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    public void Dispose() => ViewModel.PropertyChanged -= OnViewModelPropertyChanged;
}
