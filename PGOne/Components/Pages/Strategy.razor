@page "/strategy"
@inject StrategyViewModel ViewModel

<div class="page-container">
    <div class="card strategy-card">
        <div class="card-header"><h2>Strategy Configuration</h2></div>

        <div class="strategy-section">
            <h3>SuperTrend</h3>

            <div class="strategy-group">
                <h4>1 Hour</h4>
                <div class="form-row">
                    <label>Period</label>
                    <input type="number" @bind="ViewModel.Config.SuperTrend1HPeriod" class="form-input" />
                </div>
                <div class="form-row">
                    <label>Multiplier</label>
                    <input type="number" step="0.1" @bind="ViewModel.Config.SuperTrend1HMultiplier" class="form-input" />
                </div>
            </div>

            <div class="strategy-group">
                <h4>15 Minutes</h4>
                <div class="form-row">
                    <label>Period</label>
                    <input type="number" @bind="ViewModel.Config.SuperTrend15MPeriod" class="form-input" />
                </div>
                <div class="form-row">
                    <label>Multiplier</label>
                    <input type="number" step="0.1" @bind="ViewModel.Config.SuperTrend15MMultiplier" class="form-input" />
                </div>
            </div>

            <div class="strategy-group">
                <h4>5 Minutes</h4>
                <div class="form-row">
                    <label>Period</label>
                    <input type="number" @bind="ViewModel.Config.SuperTrend5MPeriod" class="form-input" />
                </div>
                <div class="form-row">
                    <label>Multiplier</label>
                    <input type="number" step="0.1" @bind="ViewModel.Config.SuperTrend5MMultiplier" class="form-input" />
                </div>
            </div>
        </div>

        <div class="strategy-section">
            <div class="form-row">
                <label>RSI Length</label>
                <input type="number" @bind="ViewModel.Config.RsiLength" class="form-input" />
            </div>
            <div class="form-row">
                <label>ADX Length</label>
                <input type="number" @bind="ViewModel.Config.AdxLength" class="form-input" />
            </div>
            <div class="form-row">
                <label>Minimum ADX</label>
                <input type="number" @bind="ViewModel.Config.MinimumAdx" class="form-input" />
            </div>
        </div>

        <div class="strategy-section">
            <h3>Entry Mode</h3>
            <div class="radio-group">
                <label class="radio-label">
                    <input type="radio" name="entryMode" checked="@(ViewModel.Config.EntryMode == EntryMode.Conservative)"
                           @onchange="() => ViewModel.Config.EntryMode = EntryMode.Conservative" />
                    Conservative
                </label>
                <label class="radio-label">
                    <input type="radio" name="entryMode" checked="@(ViewModel.Config.EntryMode == EntryMode.Normal)"
                           @onchange="() => ViewModel.Config.EntryMode = EntryMode.Normal" />
                    Normal
                </label>
                <label class="radio-label">
                    <input type="radio" name="entryMode" checked="@(ViewModel.Config.EntryMode == EntryMode.Aggressive)"
                           @onchange="() => ViewModel.Config.EntryMode = EntryMode.Aggressive" />
                    Aggressive
                </label>
            </div>
        </div>

        <button class="btn btn-primary btn-large" @onclick="Save">Save Strategy</button>

        @if (!string.IsNullOrEmpty(ViewModel.SaveMessage))
        {
            <div class="status-message success">@ViewModel.SaveMessage</div>
        }
    </div>
</div>

@code {
  private async Task Save() => await ViewModel.SaveAsync();
}
