@page "/chart"
@inject DashboardViewModel ViewModel
@inject NavigationManager Navigation

<div class="page-container">
    <div class="card chart-full">
        <div class="chart-header">
            <div class="instrument-title-row">
                <h2 class="page-heading">@ViewModel.SelectedDisplayName</h2>
                <span class="market-status @(ViewModel.IsMarketOpen ? "open" : "closed")">
                    @ViewModel.MarketStatus
                </span>
            </div>
            <div class="price-row">
                <span class="price">@ViewModel.NiftyPrice.ToString("N2")</span>
                <span class="change @(ViewModel.NiftyChange >= 0 ? "positive" : "negative")">
                    @(ViewModel.NiftyChange >= 0 ? "+" : "")@ViewModel.NiftyChangePercent.ToString("N2")%
                </span>
                <TrendBadge Trend="ViewModel.NiftyTrend" />
            </div>
        </div>
        <InstrumentChartPanel ViewModel="ViewModel"
                              CanvasId="liveChart"
                              CssClass="large"
                              Width="1200"
                              Height="520"
                              Timeframes="LiveMarketTimeframes"
                              ShowLastCandleSummary="false" />
    </div>
</div>

@code {
  private static readonly string[] LiveMarketTimeframes = ["1m", "5m", "15m", "1H", "1D"];

  protected override async Task OnInitializedAsync()
  {
    ViewModel.Disable1mCprChartOverlay();
    ViewModel.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
    if (!ViewModel.IsDashboardReady)
      await ViewModel.InitializeAsync();

    await ApplySymbolFromQueryAsync();
  }

  private async Task ApplySymbolFromQueryAsync()
  {
    var symbol = GetSymbolFromQuery();
    if (string.IsNullOrWhiteSpace(symbol))
      return;

    await ViewModel.SelectInstrumentAsync(symbol);
  }

  private string? GetSymbolFromQuery()
  {
    var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
    var query = uri.Query;
    if (string.IsNullOrEmpty(query) || query.Length < 2)
      return null;

    foreach (var part in query[1..].Split('&', StringSplitOptions.RemoveEmptyEntries))
    {
      var pair = part.Split('=', 2);
      if (pair.Length == 2 && pair[0].Equals("symbol", StringComparison.OrdinalIgnoreCase))
        return Uri.UnescapeDataString(pair[1]).Trim().ToUpperInvariant();
    }

    return null;
  }
}
