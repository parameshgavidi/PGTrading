@page "/chart"
@inject DashboardViewModel ViewModel
@implements IDisposable

<div class="page-container">
    <div class="card chart-full">
        <div class="chart-header">
            <div class="instrument-title-row">
                <h2 class="page-heading">@ViewModel.SelectedDisplayName</h2>
                <span class="market-status @(ViewModel.IsMarketOpen ? "open" : "closed")">
                    @ViewModel.MarketStatus
                </span>
            </div>
            <div class="price-row">
                <span class="price">@ViewModel.NiftyPrice.ToString("N2")</span>
                <span class="change @(ViewModel.NiftyChange >= 0 ? "positive" : "negative")">
                    @(ViewModel.NiftyChange >= 0 ? "+" : "")@ViewModel.NiftyChangePercent.ToString("N2")%
                </span>
                <TrendBadge Trend="ViewModel.NiftyTrend" />
            </div>
        </div>
        <CandlestickChart CanvasId="liveChart"
                          Candles="ViewModel.ChartCandles"
                          ChartVersion="ViewModel.ChartVersion"
                          OverlayVersion="ViewModel.OverlayVersion"
                          Analysis="ViewModel.Analysis"
                          ShowPocLevels="ViewModel.ShowPocOverlay"
                          ShowPivotLevels="ViewModel.ShowPivotOverlay"
                          ShowCamarillaLevels="ViewModel.ShowCamarillaOverlay"
                          Timeframe="ViewModel.SelectedTimeframe"
                          CssClass="large"
                          Width="1200"
                          Height="520" />
        <div class="chart-toolbar">
            <div class="timeframe-buttons">
                @foreach (var tf in new[] { "5m", "15m", "1H", "1D" })
                {
                    <button class="btn tf-btn @(ViewModel.SelectedTimeframe == tf ? "active" : "")"
                            @onclick="() => ViewModel.ChangeTimeframeAsync(tf)">@tf</button>
                }
            </div>
            <ChartOverlayToggles ShowPoc="ViewModel.ShowPocOverlay"
                                 ShowPivot="ViewModel.ShowPivotOverlay"
                                 ShowCamarilla="ViewModel.ShowCamarillaOverlay"
                                 ShowPocChanged="v => ViewModel.SetShowPocOverlay(v)"
                                 ShowPivotChanged="v => ViewModel.SetShowPivotOverlay(v)"
                                 ShowCamarillaChanged="v => ViewModel.SetShowCamarillaOverlay(v)" />
        </div>
        <div class="chart-legend">
            <span class="legend-item"><span class="legend-color buy"></span> SuperTrend BUY</span>
            <span class="legend-item"><span class="legend-color sell"></span> SuperTrend SELL</span>
            <span class="legend-item"><span class="legend-color candle-up"></span> Bullish Candle</span>
            <span class="legend-item"><span class="legend-color candle-down"></span> Bearish Candle</span>
            @if (ViewModel.SelectedTimeframe == "5m")
            {
                <span class="legend-item"><span class="legend-color keltner"></span> Keltner (20, 1.5/2.0)</span>
                <span class="legend-item"><span class="legend-color vwap"></span> VWAP</span>
            }
            @if (ViewModel.ShowPocOverlay)
            {
                <span class="legend-item"><span class="legend-color poc"></span> POC / VA</span>
            }
            @if (ViewModel.ShowPivotOverlay)
            {
                <span class="legend-item"><span class="legend-color pivot"></span> Pivot / CPR</span>
            }
            @if (ViewModel.ShowCamarillaOverlay)
            {
                <span class="legend-item"><span class="legend-color camarilla"></span> Camarilla</span>
            }
        </div>
    </div>
</div>

@code {
  protected override async Task OnInitializedAsync()
  {
    await ViewModel.InitializeAsync();
    ViewModel.PropertyChanged += (_, _) => InvokeAsync(StateHasChanged);
  }

  public void Dispose() { }
}
