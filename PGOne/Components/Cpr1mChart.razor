@namespace PGOne.Components
@using PGOne.Models
@inject IJSRuntime JS

<div class="chart-area @CssClass">
    <div class="chart-zoom-controls">
        <button type="button" class="zoom-btn" title="Zoom in" @onclick="ZoomIn">+</button>
        <button type="button" class="zoom-btn" title="Zoom out" @onclick="ZoomOut">−</button>
        <button type="button" class="zoom-btn" title="Reset zoom" @onclick="ResetZoom">⟳</button>
    </div>
    <canvas id="@CanvasId" width="@Width" height="@Height"></canvas>
</div>

@code {
    [Parameter] public string CanvasId { get; set; } = "cpr1mChart";
    [Parameter] public List<Candle> Candles { get; set; } = new();
    [Parameter] public IReadOnlyList<IntradayCprSegment> Segments { get; set; } = Array.Empty<IntradayCprSegment>();
    [Parameter] public MultiTimeframeAnalysis? Analysis { get; set; }
    [Parameter] public int ChartVersion { get; set; }
    [Parameter] public int OverlayVersion { get; set; }
    [Parameter] public bool ShowKeltnerLevels { get; set; } = true;
    [Parameter] public bool ShowPivotLevels { get; set; }
    [Parameter] public string CssClass { get; set; } = string.Empty;
    [Parameter] public int Width { get; set; } = 1200;
    [Parameter] public int Height { get; set; } = 520;

    private int _lastRenderedVersion = -1;
    private int _lastOverlayVersion = -1;
    private bool _lastShowKeltner;
    private bool _lastShowPivot;
    private int _lastSegmentCount;
    private string _lastSegmentKey = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Candles.Count == 0)
            return;

        var segmentKey = BuildSegmentKey();
        if (ChartVersion == _lastRenderedVersion
            && OverlayVersion == _lastOverlayVersion
            && ShowKeltnerLevels == _lastShowKeltner
            && ShowPivotLevels == _lastShowPivot
            && Segments.Count == _lastSegmentCount
            && segmentKey == _lastSegmentKey)
            return;

        if (!await RenderAsync(firstRender))
            return;

        _lastRenderedVersion = ChartVersion;
        _lastOverlayVersion = OverlayVersion;
        _lastShowKeltner = ShowKeltnerLevels;
        _lastShowPivot = ShowPivotLevels;
        _lastSegmentCount = Segments.Count;
        _lastSegmentKey = segmentKey;
    }

    private string BuildSegmentKey() =>
        string.Join('|', Segments.Select(s => $"{s.Start:O}:{s.Pivot}:{s.Tc}:{s.Bc}"));

    private async Task ZoomIn() => await InvokeSafe("pgOneCprChart.zoom", CanvasId, 1.3);
    private async Task ZoomOut() => await InvokeSafe("pgOneCprChart.zoom", CanvasId, 1 / 1.3);
    private async Task ResetZoom() => await InvokeSafe("pgOneCprChart.resetZoom", CanvasId);

    private async Task<bool> InvokeSafe(string fn, params object[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(fn, args);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private async Task<bool> RenderAsync(bool firstRender)
    {
        var payload = Candles.Select(c => new
        {
            time = ChartJsTime.ToEpochMs(c.Timestamp),
            open = c.Open,
            high = c.High,
            low = c.Low,
            close = c.Close,
            keltnerUpperInner = c.KeltnerUpperInner,
            keltnerLowerInner = c.KeltnerLowerInner,
            keltnerUpperOuter = c.KeltnerUpperOuter,
            keltnerLowerOuter = c.KeltnerLowerOuter,
            keltnerMid = c.KeltnerMid
        }).ToList();

        var segmentPayload = Segments.Select(s => new
        {
            start = ChartJsTime.ToEpochMs(s.Start),
            end = ChartJsTime.ToEpochMs(s.End),
            pivot = s.Pivot,
            tc = s.Tc,
            bc = s.Bc
        }).ToList();

        var levels = BuildLevelPayload();
        var overlayOptions = new
        {
            showKeltner = ShowKeltnerLevels,
            showPivot = ShowPivotLevels
        };

        for (var attempt = 0; attempt < (firstRender ? 5 : 1); attempt++)
        {
            if (await InvokeSafe("pgOneCprChart.draw", CanvasId, payload, segmentPayload, levels, overlayOptions))
                return true;

            await Task.Delay(120);
        }

        return false;
    }

    private List<object> BuildLevelPayload()
    {
        if (Analysis is null || !ShowPivotLevels)
            return new List<object>();

        return SupportResistanceLadderBuilder.Build(Analysis)
            .Where(row => row.Group == "cpr")
            .Select(row => new
            {
                label = row.Label,
                price = row.Price,
                group = row.Group,
                kind = row.CssClass
            })
            .Cast<object>()
            .ToList();
    }
}
