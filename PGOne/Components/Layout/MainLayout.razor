@namespace PGOne.Components.Layout
@using PGOne.Services
@inherits LayoutComponentBase
@inject IZerodhaService ZerodhaService
@inject NavigationManager Navigation
@implements IDisposable

<div class="app-shell">
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="sidebar-brand"><span class="brand-pg">PG</span> <span class="brand-one">one</span></div>
            <div class="sidebar-tagline">Trade Smart. Stay Ahead.</div>
        </div>
        <NavMenu />
        <div class="sidebar-footer">
            <div class="connection-status @(_isConnected ? "connected" : "disconnected")">
                <span class="status-dot"></span>
                @(_isConnected ? "Broker linked" : "Broker offline")
            </div>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-bar">
            <div class="top-bar-left">
                <h1 class="page-title">@_pageTitle</h1>
                @if (!string.IsNullOrEmpty(_pageSubtitle))
                {
                    <p class="page-subtitle">@_pageSubtitle</p>
                }
            </div>
            <div class="top-bar-right">
                @if (_isConnected)
                {
                    <span class="connection-badge connected" title="Zerodha connected">
                        <span class="status-dot"></span>
                        Connected
                    </span>
                }
                else
                {
                    <a class="connection-badge disconnected connection-cta" href="settings" title="Connect Zerodha in Settings">
                        <span class="status-dot"></span>
                        Connect broker
                    </a>
                }
                <span class="clock" title="Local time">@_currentTime</span>
            </div>
        </header>
        <article class="content-area">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _isConnected;
    private string _currentTime = DateTime.Now.ToString("hh:mm:ss tt");
    private string _pageTitle = "Dashboard";
    private string _pageSubtitle = string.Empty;
    private System.Timers.Timer? _timer;

    protected override void OnInitialized()
    {
        AppUiEvents.RaiseShellRendered();
        _isConnected = ZerodhaService.IsConnected;
        ZerodhaService.ConnectionChanged += OnConnectionChanged;
        Navigation.LocationChanged += OnNavigationChanged;
        UpdatePageTitle();

        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += (_, _) =>
        {
            _currentTime = DateTime.Now.ToString("hh:mm:ss tt");
            InvokeAsync(StateHasChanged);
        };
        _timer.Start();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
            AppUiEvents.RaiseShellRendered();
    }

    private void OnConnectionChanged(bool connected)
    {
        _isConnected = connected;
        InvokeAsync(StateHasChanged);
    }

    private void OnNavigationChanged(object? sender, LocationChangedEventArgs e) =>
        InvokeAsync(() =>
        {
            UpdatePageTitle();
            StateHasChanged();
        });

    private void UpdatePageTitle()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();
        (_pageTitle, _pageSubtitle) = path switch
        {
            "" or "dashboard" => ("Dashboard", "Market overview & chart"),
            "framework" => ("Framework", "Playbook & bias checklist"),
            "chart" => ("Live Market", "Realtime chart & overlays"),
            "multi-chart" => ("Multi Chart", "Compare symbols side by side"),
            "scanner" => ("Scanner", "Intraday & long-term scans"),
            "sentiment" => ("Sentiment", "News-driven bias · Buy CNC"),
            "signals" => ("Signals", "Setup readiness & index options"),
            "positions" => ("Positions", "Open MIS / NRML risk"),
            "orders" => ("Orders", "Today’s order book"),
            "watchlist" => ("Watchlist", "Tracked symbols"),
            "auto-buy" => ("Auto Buy", "Long CNC automation"),
            "settings" => ("Settings", "Broker & API configuration"),
            "holdings" => ("Holdings", "Delivery portfolio"),
            "strategy" => ("Strategy", "Rules & risk notes"),
            _ => ("PG One", string.Empty)
        };
    }

    public void Dispose()
    {
        ZerodhaService.ConnectionChanged -= OnConnectionChanged;
        Navigation.LocationChanged -= OnNavigationChanged;
        _timer?.Dispose();
    }
}
