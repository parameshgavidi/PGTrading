@namespace PGOne.Components

<div class="ai-insight-panel card">
    <div class="ai-insight-title">AI Analysis</div>
    <div class="ai-check-list">
        @foreach (var check in Checks)
        {
            <div class="ai-check @check.State">@check.Label</div>
        }
    </div>
    <div class="ai-probability">
        <div class="ai-probability-label">Overall Score</div>
        <div class="ai-probability-value @GetProbabilityClass()">@Analysis.OverallScore%</div>
        <div class="ai-probability-strength @GetStrengthClass()">@Analysis.Strength</div>
    </div>
    <div class="ai-suggested">
        <div class="ai-suggested-label">Suggested</div>
        <div class="ai-suggested-action @GetActionClass()">@SuggestedAction</div>
    </div>
</div>

@code {
    [Parameter] public MultiTimeframeAnalysis Analysis { get; set; } = new();
    [Parameter] public string SuggestedAction { get; set; } = "HOLD / NEUTRAL";

    private IReadOnlyList<AiCheck> Checks => AiInsightHelper.BuildChecks(Analysis);

    private string GetProbabilityClass() => Analysis.OverallScore switch
    {
        >= 70 => "high",
        >= 45 => "mid",
        _ => "low"
    };

    private string GetStrengthClass() => Analysis.Strength1H switch
    {
        TrendStrength.Strong => "strong",
        TrendStrength.Moderate => "moderate",
        _ => "weak"
    };

    private string GetActionClass() => SuggestedAction switch
    {
        var s when s.StartsWith("BUY", StringComparison.Ordinal) => "buy",
        var s when s.StartsWith("SELL", StringComparison.Ordinal) => "sell",
        "WAIT" => "wait",
        _ => "neutral"
    };
}
