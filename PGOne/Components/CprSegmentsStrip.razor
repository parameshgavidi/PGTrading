@namespace PGOne.Components
@using PGOne.Models

@if (Segments.Count > 0)
{
    <div class="cpr-segments-panel">
        <div class="cpr-levels-strip">
            <span class="cpr-level-label">1m CPR · 15m pivot</span>
            @if (ActiveSegment is not null)
            {
                <span class="cpr-segment-active-label">@FormatWindow(ActiveSegment)</span>
                <span>TC <strong>@ActiveSegment.Tc.ToString("N2")</strong></span>
                <span>CPR <strong>@ActiveSegment.Pivot.ToString("N2")</strong></span>
                <span>BC <strong>@ActiveSegment.Bc.ToString("N2")</strong></span>
            }
        </div>
        <div class="cpr-segments-grid">
            @foreach (var seg in Segments)
            {
                var isActive = ActiveSegment is not null && seg.Start == ActiveSegment.Start && seg.End == ActiveSegment.End;
                <div class="cpr-segment-row @(isActive ? "active" : "")">
                    <span class="cpr-segment-time">@FormatWindow(seg)</span>
                    <span>TC @seg.Tc.ToString("N2")</span>
                    <span>CPR @seg.Pivot.ToString("N2")</span>
                    <span>BC @seg.Bc.ToString("N2")</span>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter] public IReadOnlyList<IntradayCprSegment> Segments { get; set; } = Array.Empty<IntradayCprSegment>();
    [Parameter] public IntradayCprSegment? ActiveSegment { get; set; }

    private static string FormatWindow(IntradayCprSegment seg) =>
        $"{seg.Start:HH:mm}–{seg.End:HH:mm}";
}
