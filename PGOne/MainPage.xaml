<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:PGOne.Components"
             x:Class="PGOne.MainPage"
             BackgroundColor="#121212">

    <Grid>
        <BlazorWebView x:Name="blazorWebView"
                       HostPage="wwwroot/index.html"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill"
                       BlazorWebViewInitialized="OnBlazorWebViewInitialized">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <Border x:Name="errorPanel"
                IsVisible="False"
                BackgroundColor="#1E1E1E"
                Stroke="#FF1744"
                StrokeThickness="1"
                Padding="24"
                Margin="24"
                VerticalOptions="Center"
                HorizontalOptions="Center">
            <VerticalStackLayout Spacing="12" MaximumWidthRequest="520">
                <Label Text="PG One could not load the UI"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label x:Name="errorMessage"
                       TextColor="#B0B0B0"
                       LineBreakMode="WordWrap" />
                <Label Text="WebView2 is required on Windows. Install the Evergreen runtime, then restart the app."
                       TextColor="#B0B0B0"
                       LineBreakMode="WordWrap" />
                <Label Text="Download: https://go.microsoft.com/fwlink/p/?LinkId=2124703"
                       TextColor="#2196F3"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
        </Border>
    </Grid>

</ContentPage>
