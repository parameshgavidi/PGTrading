@namespace PGOneTrade.Components.Layout
@using PGOneTrade.Services
@using PGOneTrade.ViewModels
@inject DashboardViewModel Dashboard
@inject IWatchlistService Watchlist
@inject IUiLayoutService Layout
@inject NavigationManager Navigation
@implements IDisposable

<div class="nav-menu">
    <div class="nav-section-label">Monitor</div>
    <NavLink class="nav-item" href="" Match="NavLinkMatch.All">
        <span class="nav-mark" aria-hidden="true">D</span> Dashboard
    </NavLink>
    <NavLink class="nav-item" href="framework">
        <span class="nav-mark" aria-hidden="true">F</span> Framework
    </NavLink>
    <NavLink class="nav-item" href="multi-chart">
        <span class="nav-mark" aria-hidden="true">M</span> Multi Chart
    </NavLink>

    <div class="nav-accordion @(Layout.IsNiftyAccordionOpen ? "open" : "")">
        <button type="button"
                class="nav-accordion-toggle"
                title="Show / hide Nifty Top 10"
                @onclick="ToggleNiftyAccordionAsync">
            <span class="nav-mark" aria-hidden="true">N</span>
            <span class="nav-accordion-title">Nifty Top 10</span>
            <span class="nav-accordion-chevron" aria-hidden="true"></span>
        </button>
        @if (Layout.IsNiftyAccordionOpen)
        {
            <div class="nav-accordion-body">
                <div class="nav-accordion-group-label">Indices</div>
                @foreach (var item in Watchlist.IndexItems)
                {
                    <button type="button"
                            class="nav-stock-row @(IsSelected(item.Symbol) ? "selected" : "")"
                            @onclick="() => SelectSymbolAsync(item.Symbol)">
                        <span class="nav-stock-symbol">@InstrumentMapper.ToIndexShortName(item.Symbol)</span>
                        <span class="nav-stock-change @(item.ChangePercent >= 0 ? "positive" : "negative")">
                            @(item.ChangePercent >= 0 ? "+" : "")@item.ChangePercent.ToString("N2")%
                        </span>
                    </button>
                }

                <div class="nav-accordion-group-label">Top 10 weight</div>
                @if (Watchlist.Top10WeightItems.Count == 0)
                {
                    <div class="nav-accordion-empty">
                        @(Watchlist.IsLoading ? "Loading…" : "Waiting for quotes…")
                    </div>
                }
                else
                {
                    @foreach (var item in Watchlist.Top10WeightItems)
                    {
                        <button type="button"
                                class="nav-stock-row @(IsSelected(item.Symbol) ? "selected" : "")"
                                @onclick="() => SelectSymbolAsync(item.Symbol)">
                            <span class="nav-stock-symbol">@item.Symbol</span>
                            <span class="nav-stock-meta">
                                @if (item.Weight > 0)
                                {
                                    <span class="nav-stock-weight">@item.Weight.ToString("N1")%</span>
                                }
                                <span class="nav-stock-change @(item.ChangePercent >= 0 ? "positive" : "negative")">
                                    @(item.ChangePercent >= 0 ? "+" : "")@item.ChangePercent.ToString("N2")%
                                </span>
                            </span>
                        </button>
                    }
                }
            </div>
        }
    </div>

    <NavLink class="nav-item" href="scanner">
        <span class="nav-mark" aria-hidden="true">C</span> Scanner
    </NavLink>
    <NavLink class="nav-item" href="sentiment">
        <span class="nav-mark" aria-hidden="true">T</span> Sentiment
    </NavLink>

    <div class="nav-section-label">Trade</div>
    <NavLink class="nav-item" href="signals">
        <span class="nav-mark" aria-hidden="true">X</span> Signals
    </NavLink>
    <NavLink class="nav-item" href="auto-buy">
        <span class="nav-mark" aria-hidden="true">A</span> Auto Buy
    </NavLink>
    <NavLink class="nav-item" href="watchlist">
        <span class="nav-mark" aria-hidden="true">W</span> Watchlist
    </NavLink>

    <div class="nav-section-label">Portfolio</div>
    <NavLink class="nav-item" href="positions">
        <span class="nav-mark" aria-hidden="true">P</span> Positions
    </NavLink>
    <NavLink class="nav-item" href="orders">
        <span class="nav-mark" aria-hidden="true">O</span> Orders
    </NavLink>
    <NavLink class="nav-item" href="holdings">
        <span class="nav-mark" aria-hidden="true">H</span> Holdings
    </NavLink>

    <div class="nav-section-label">System</div>
    <NavLink class="nav-item" href="strategy">
        <span class="nav-mark" aria-hidden="true">Y</span> Strategy
    </NavLink>
    <NavLink class="nav-item" href="settings">
        <span class="nav-mark" aria-hidden="true">S</span> Settings
    </NavLink>
</div>

@code {
    protected override void OnInitialized()
    {
        Dashboard.PropertyChanged += OnDashboardChanged;
        Watchlist.WatchlistUpdated += OnWatchlistUpdated;
        Layout.Changed += OnLayoutChanged;
        _ = Watchlist.RefreshTopWeightageAsync();
    }

    private async Task ToggleNiftyAccordionAsync() => await Layout.ToggleNiftyAccordionAsync();

    private async Task SelectSymbolAsync(string symbol)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        if (!string.IsNullOrEmpty(path) && !path.Equals("dashboard", StringComparison.OrdinalIgnoreCase))
            Navigation.NavigateTo("/");

        await Dashboard.SelectInstrumentAsync(symbol);
    }

    private bool IsSelected(string symbol) =>
        string.Equals(Dashboard.SelectedSymbol, symbol, StringComparison.OrdinalIgnoreCase);

    private void OnDashboardChanged(object? sender, System.ComponentModel.PropertyChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private void OnWatchlistUpdated() => InvokeAsync(StateHasChanged);

    private void OnLayoutChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Dashboard.PropertyChanged -= OnDashboardChanged;
        Watchlist.WatchlistUpdated -= OnWatchlistUpdated;
        Layout.Changed -= OnLayoutChanged;
    }
}
