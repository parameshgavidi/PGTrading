    <Compile Include="../PgAiTrading/Services/ChartPatternService.cs" Link="Services/ChartPatternService.cs" />
    <Compile Include="../PgAiTrading/Services/SuperTrendService.cs" Link="Services/SuperTrendService.cs" />
    <Compile Include="../PgAiTrading/Services/SentimentTextHelper.cs" Link="Services/SentimentTextHelper.cs" />
    <Compile Include="../PgAiTrading/Services/LiveNewsImportance.cs" Link="Services/LiveNewsImportance.cs" />
    <Compile Include="../PgAiTrading/Services/NiftyIndexService.cs" Link="Services/NiftyIndexService.cs" />
  </ItemGroup>

</Project>
